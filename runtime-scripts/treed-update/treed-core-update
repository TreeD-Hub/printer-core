#!/usr/bin/env python3
"""Назначение: пакет и транзакционная доставка компонентов TreeD без provisioning.
Контур: build read-only к repo; baseline/apply/recover root-only под lock worker.
"""

from __future__ import annotations

# Блок 1: Фиксированный контракт пакета и разрешённые назначения.
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import shlex
import signal
import stat
import subprocess
import sys
import tempfile
import time
import urllib.request
import uuid
import zipfile
from contextlib import contextmanager

KIND = "treed-core-runtime"
ASSET = "treed-core-runtime.zip"
SOURCE_ASSET = "treed-mainshellos-source.zip"
MARKER = b"#*# <---------------------- SAVE_CONFIG ---------------------->"
SBIN = {"treed-core-update", "treed-update-service", "treed-update-apply", "treed-ui",
        "treed-loading-screen"}
CAMERA = {"cam_env.sh", "session_start.sh", "session_stop.sh", "snapshot.sh", "stream_detect.py"}
VISION = {"service.py", "models.json"}
PRESERVED = {"local_overrides.cfg", "treed_variables.cfg", "filament_motion_runtime.cfg"}
MAX_PACKAGE = 32 * 1024 * 1024
MAX_CONTENT = 64 * 1024 * 1024
AUTOPRINTER_MODULES = {f"moonraker/treed_autoprinter{suffix}.py" for suffix in (
    "", "_store", "_transport", "_execution", "_device", "_bed", "_bed_inference",
)} | {"moonraker/treed_vision_client.py"}


def validate_autoprinter_files(files):
    # Частичный комплект не должен заменять работающий компонент при update.
    present = AUTOPRINTER_MODULES.intersection(files)
    if present and present != AUTOPRINTER_MODULES:
        raise ValueError("Core пакет содержит неполный AutoPrinter")


def allowed(key):
    if not isinstance(key, str):
        raise ValueError("Недопустимый путь в пакете core")
    path = PurePosixPath(key)
    if (path.as_posix() != key or "\\" in key
            or path.is_absolute() or ".." in path.parts or len(path.parts) < 2):
        raise ValueError("Недопустимый путь в пакете core")
    group, *parts = path.parts
    relative = PurePosixPath(*parts)
    valid = (
        group == "config" and (
            str(relative) in {"printer.cfg", "moonraker.conf"}
            or len(parts) == 3 and parts[:2] == ["profiles", "treed_v2_corexy_v1"]
            and relative.suffix == ".cfg" and relative.name not in PRESERVED
            or len(parts) == 3 and parts[:2] == ["moonraker", "base"] and relative.suffix == ".conf"
        )
        or group in {"klipper", "moonraker"} and len(parts) == 1
        and re.fullmatch(r"treed_[a-z0-9_]+\.py", parts[0]) is not None
        or group == "camera" and len(parts) == 1 and parts[0] in CAMERA
        or group == "vision" and len(parts) == 1 and parts[0] in VISION
        or group == "sbin" and len(parts) == 1 and parts[0] in SBIN
    )
    if not valid:
        raise ValueError(f"Назначение не принадлежит пакету TreeD: {key}")
    return group, relative


def sha(data):
    return hashlib.sha256(data).hexdigest()


def sources(repo):
    items = {"config/printer.cfg": repo / "klipper/printer.cfg",
             "config/moonraker.conf": repo / "moonraker/moonraker.conf"}
    for prefix, directory, pattern in (
        ("config/profiles/treed_v2_corexy_v1", "klipper/profiles/treed_v2_corexy_v1", "*.cfg"),
        ("config/moonraker/base", "moonraker/base", "*.conf"),
        ("klipper", "klipper-host", "treed_*.py"),
        ("moonraker", "moonraker/components", "treed_*.py"),
    ):
        for path in sorted((repo / directory).glob(pattern)):
            items[f"{prefix}/{path.name}"] = path
    items["klipper/treed_sgt_calibration.py"] = repo / "tools/treed_sgt_calibration.py"
    for name in CAMERA:
        items[f"camera/{name}"] = repo / "runtime-scripts/treed-cam" / name
    for name in VISION:
        items[f"vision/{name}"] = repo / "runtime-scripts/treed-vision" / name
    for name in SBIN:
        directory = "treed-ui" if name == "treed-ui" else "treed-update"
        items[f"sbin/{name}"] = repo / "runtime-scripts" / directory / name
    validate_autoprinter_files(items)
    for key, path in items.items():
        allowed(key)
        if path.is_symlink() or not path.is_file():
            raise ValueError(f"Исходник пакета отсутствует или является ссылкой: {path}")
    return items


def git_head(path):
    # Root-worker читает checkout пользователя; доверие ограничено одним путём и вызовом.
    return subprocess.check_output(["git", "-c", f"safe.directory={path.resolve().as_posix()}",
                                   "-C", str(path), "rev-parse", "HEAD"],
                                   text=True, timeout=10).strip()


def package_manifest(repo):
    version = (repo / "VERSION").read_text(encoding="utf-8").strip()
    if re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version) is None:
        raise ValueError("VERSION должен быть x.y.z")
    runtime = (repo / "runtime-versions.env").read_text(encoding="utf-8")
    requirements = {}
    for component in ("KLIPPER", "MOONRAKER"):
        match = re.search(rf'^TREED_{component}_REF="([0-9a-f]{{40}})"$', runtime, re.M)
        if not match:
            raise ValueError(f"Отсутствует закреплённый SHA {component}")
        requirements[component.lower()] = match[1]
    return {"kind": KIND, "schema": 1, "version": version, "tag": f"v{version}",
            "sha": git_head(repo), "requires": requirements,
            "provisioning": {"schema": 1, "revision": provisioning_revision(repo)}, "files": []}


def provisioning_revision(repo):
    digest = hashlib.sha256()
    paths = (sorted(path for path in (repo / "loader").rglob("*.sh"))
             + [repo / "runtime-versions.env", repo / "runtime-scripts/treed-vision/models.json"])
    for path in paths:
        if path.is_symlink():
            raise ValueError(f"Provisioning source is a symlink: {path}")
        if path.is_file():
            relative = path.relative_to(repo).as_posix().encode("utf-8")
            data = path.read_bytes()
            digest.update(len(relative).to_bytes(4, "big")); digest.update(relative)
            digest.update(len(data).to_bytes(8, "big")); digest.update(data)
    return digest.hexdigest()


def build(repo, archive):
    manifest = package_manifest(repo)
    archive.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as bundle:
        for key, path in sorted(sources(repo).items()):
            data = path.read_bytes()
            manifest["files"].append({"path": key, "sha256": sha(data)})
            bundle.writestr("payload/" + key, data)
        bundle.writestr("manifest.json", json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")


def build_source(repo, archive):
    repo = repo.resolve()
    paths = subprocess.check_output(["git", "-C", str(repo), "ls-files", "-z"], timeout=10).split(b"\0")
    archive.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as bundle:
        for raw in sorted(path for path in paths if path):
            relative = PurePosixPath(raw.decode("utf-8"))
            path = repo.joinpath(*relative.parts)
            if path.is_symlink() or not path.is_file():
                raise ValueError(f"Source package содержит ссылку или отсутствующий файл: {relative}")
            bundle.writestr(relative.as_posix(), path.read_bytes())


# Блок 2: Root-owned настройки; архив не может назначать произвольные пути.
def settings():
    env = {}
    env_file = Path(os.environ.get("TREED_UPDATE_ENV_FILE", "/etc/default/treed-update"))
    if env_file.exists():
        for line in env_file.read_text(encoding="utf-8").splitlines():
            name, separator, value = line.partition("=")
            if separator and name.startswith("TREED_"):
                values = shlex.split(value)
                if len(values) == 1:
                    env[name] = values[0]
    env.update(os.environ)
    env.setdefault("TREED_UPDATE_PI_HOME", "/home/pi")
    env.setdefault("TREED_UPDATE_PI_USER", "pi")
    env.setdefault("TREED_UPDATE_PI_GROUP", env["TREED_UPDATE_PI_USER"])
    return env


def roots(env):
    home = Path(env.get("TREED_UPDATE_PI_HOME", "/home/pi"))
    result = {
        "config": home / "printer_data/config",
        "klipper": Path(env.get("TREED_CORE_KLIPPER_DIR", str(home / "klipper"))) / "klippy/extras",
        "moonraker": Path(env.get("TREED_CORE_MOONRAKER_DIR", str(home / "moonraker"))) / "moonraker/components",
        "camera": home / "treed/cam/bin",
        "vision": home / "treed/vision/bin",
        "sbin": Path("/usr/local/sbin"),
    }
    if not home.is_absolute() or ".." in home.parts or any(
        not path.is_absolute() or ".." in path.parts for path in result.values()
    ):
        raise ValueError("Недопустимые runtime-пути core")
    return result


def destination(key, locations):
    group, relative = allowed(key)
    return locations[group] / str(relative)


@contextmanager
def parent_fd(path, create=False):
    # Linux: O_NOFOLLOW на каждом каталоге и операции через dir_fd закрывают
    # подмену user-owned parent на symlink между проверкой и записью от root.
    if os.name == "nt":
        for part in (path.parent, *path.parent.parents):
            if part.is_symlink():
                raise ValueError(f"Runtime-путь является ссылкой: {part}")
        if create:
            path.parent.mkdir(parents=True, exist_ok=True)
        yield None
        return
    descriptor = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for name in path.parent.parts[1:]:
            if create:
                try:
                    os.mkdir(name, 0o755, dir_fd=descriptor)
                    os.fsync(descriptor)
                except FileExistsError:
                    pass
            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
        yield descriptor
    finally:
        os.close(descriptor)


def read_file(path):
    with parent_fd(path) as descriptor:
        try:
            info = os.stat(path.name if descriptor is not None else path,
                           dir_fd=descriptor, follow_symlinks=False)
        except FileNotFoundError:
            return None, None
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_CONTENT:
            raise ValueError(f"Runtime-файл не является обычным файлом: {path}")
        handle = os.open(path.name if descriptor is not None else path,
                         os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=descriptor)
        with os.fdopen(handle, "rb") as stream:
            return stream.read(MAX_CONTENT + 1), info


def write_file(path, data, mode=0o644, uid=None, gid=None):
    with parent_fd(path, create=True) as descriptor:
        name = path.name + "." + str(uuid.uuid4()) + ".tmp"
        target = name if descriptor is not None else path.with_name(name)
        handle = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode, dir_fd=descriptor)
        try:
            if os.name != "nt":
                os.fchmod(handle, mode)
                if uid is not None and gid is not None:
                    os.fchown(handle, uid, gid)
            with os.fdopen(handle, "wb", closefd=False) as stream:
                stream.write(data)
                stream.flush()
                os.fsync(handle)
        finally:
            os.close(handle)
        os.replace(target, path.name if descriptor is not None else path,
                   src_dir_fd=descriptor, dst_dir_fd=descriptor)
        if descriptor is not None:
            os.fsync(descriptor)


def remove_file(path):
    with parent_fd(path) as descriptor:
        try:
            os.unlink(path.name if descriptor is not None else path, dir_fd=descriptor)
        except FileNotFoundError:
            pass
        if descriptor is not None:
            os.fsync(descriptor)


def clear_bytecode(entries, locations):
    # При быстром rollback mtime/размер .py могут совпасть с новым pyc.
    # Удаляем только кеш затронутых TreeD-модулей перед запуском процесса.
    for row in entries:
        group, _relative = allowed(row["path"])
        if group in {"klipper", "moonraker"}:
            path = destination(row["path"], locations)
            cache = path.parent / "__pycache__"
            if cache.is_dir():
                for item in cache.glob(path.stem + ".*.pyc"):
                    remove_file(item)


def read_json(path):
    data, _info = read_file(path)
    return json.loads(data) if data is not None else None


def write_json(path, value):
    write_file(path, (json.dumps(value, ensure_ascii=False, indent=2) + "\n").encode("utf-8"))


def content_hash(key, data):
    if key == "config/printer.cfg":
        data = data.split(MARKER, 1)[0].rstrip(b"\r\n")
    return sha(data)


def saved_pid_fields(data):
    # SAVE_CONFIG комментирует исходные PID в основном файле, сохраняя их значения.
    fields, section = set(), b""
    for line in data.partition(MARKER)[2].splitlines():
        if not line.startswith(b"#*# "):
            continue
        line = line[4:].strip().lower()
        if line.startswith(b"[") and line.endswith(b"]"):
            section = line[1:-1]
        elif section in {b"extruder", b"heater_bed"}:
            option = re.match(rb"(control|pid_kp|pid_ki|pid_kd)\s*=", line)
            if option:
                fields.add((section, option[1]))
    return fields


def pid_line_numbers(lines, fields, commented=False):
    section = b""
    for index, line in enumerate(lines):
        header = re.fullmatch(rb"\[([^]]+)\]\s*(?:[#;].*)?", line.strip())
        if header:
            section = header[1].strip().lower()
        if commented:
            if not line.startswith(b"#"):
                continue
            line = line[1:]
        option = re.match(rb"(control|pid_kp|pid_ki|pid_kd)\s*[:=]", line.strip(), re.I)
        if option and (section, option[1].lower()) in fields:
            yield index


def matches_managed_file(key, data, expected_hash):
    if content_hash(key, data) == expected_hash:
        return True
    if key != "config/printer.cfg":
        return False
    lines = data.partition(MARKER)[0].splitlines(keepends=True)
    indices = list(pid_line_numbers(lines, saved_pid_fields(data), commented=True))
    # Совместимость с уже записанными manifest: часть PID могла быть сохранена раньше.
    # Проверяем только снятие одного штатного '#', без изменений исходных значений.
    # Два нагревателя по четыре поля дают не более 256 вариантов исходного hash.
    if len(indices) > 8:
        return False
    for mask in range(1, 1 << len(indices)):
        candidate = list(lines)
        for bit, index in enumerate(indices):
            if mask & (1 << bit):
                candidate[index] = candidate[index][1:]
        if content_hash(key, b"".join(candidate)) == expected_hash:
            return True
    return False


def render(key, data, old, env):
    if key == "config/printer.cfg":
        data = data.split(MARKER, 1)[0]
        if old and MARKER in old:
            lines = data.splitlines(keepends=True)
            for index in pid_line_numbers(lines, saved_pid_fields(old)):
                lines[index] = b"#" + lines[index]
            data = b"".join(lines)
            data = data.rstrip(b"\r\n") + b"\n\n" + MARKER + old.split(MARKER, 1)[1]
    if key.startswith("config/moonraker/base/"):
        text = data.decode("utf-8").replace("{{PI_HOME}}", env["TREED_UPDATE_PI_HOME"])
        text = text.replace("{{PI_USER}}", env["TREED_UPDATE_PI_USER"])
        if key == "config/moonraker/base/00-core.conf" and old:
            # Updater-пути Mainsail/Crowsnest определил loader для этой установки.
            for name in ("mainsail", "crowsnest"):
                pattern = rf"(?m)^\[update_manager {name}\][^\[]*"
                previous = re.search(pattern, old.decode("utf-8"))
                text = re.sub(pattern, lambda _m: previous[0] if previous else "", text)
            text = merge_local_section(text, old.decode("utf-8"), "treed_autoprinter")
        data = text.encode("utf-8")
    if key.endswith(".py") or key.startswith("sbin/") and key != "sbin/treed-ui" and key != "sbin/treed-update-apply":
        compile(data, key, "exec")
    if key.endswith(".sh") or key in {"sbin/treed-ui", "sbin/treed-update-apply"}:
        subprocess.run(["bash", "-n"], input=data, check=True, timeout=10)
    return data


def merge_local_section(default_text, previous_text, name):
    # Локальная identity/storage остаётся у устройства; новые параметры берутся из defaults.
    section = re.compile(rf"^\s*\[{re.escape(name)}\]\s*$", re.I)
    header = re.compile(r"^\s*\[[^]]+\]\s*$")

    def body(lines):
        for start, line in enumerate(lines):
            if section.fullmatch(line):
                end = start + 1
                while end < len(lines) and not header.fullmatch(lines[end]):
                    end += 1
                return start, end, lines[start], lines[start + 1:end]
        return None, None, None, []

    old_lines, new_lines = previous_text.splitlines(), default_text.splitlines()
    _old_start, _old_end, old_header, old_body = body(old_lines)
    new_start, new_end, new_header, new_body = body(new_lines)
    if old_header is None or new_header is None:
        return default_text
    legacy = {"enabled", "execution_enabled", "bed_check_enabled"}
    old_body = [line for line in old_body if not (
        (match := re.match(r"^\s*([A-Za-z0-9_]+)\s*[:=]", line))
        and name == "treed_autoprinter" and match[1].lower() in legacy)]
    keys = set()
    for line in old_body:
        match = re.match(r"^\s*([A-Za-z0-9_]+)\s*[:=]", line)
        if match:
            keys.add(match.group(1).lower())
    additions = []
    for line in new_body:
        match = re.match(r"^\s*([A-Za-z0-9_]+)\s*[:=]", line)
        if match and match.group(1).lower() not in keys:
            additions.append(line)
            keys.add(match.group(1).lower())
    new_lines[new_start:new_end] = [new_header, *old_body, *additions]
    return "\n".join(new_lines) + "\n"


# Блок 3: Release download, валидация архива и совместимости с текущим стеком.
def download(tag, archive, env, asset_name=ASSET):
    api = env.get("TREED_CORE_RELEASE_API_URL", "https://api.github.com/repos/TreeD-Hub/printer-core/releases")
    if not api.startswith("https://api.github.com/repos/"):
        raise ValueError("Core release API должен быть GitHub HTTPS")
    request = urllib.request.Request(api.rstrip("/") + "/tags/" + tag,
                                     headers={"Accept": "application/vnd.github+json", "User-Agent": "treed-core-update"})
    with urllib.request.urlopen(request, timeout=10) as response:
        release = json.load(response)
    if release.get("tag_name") != tag or release.get("draft") or release.get("prerelease"):
        raise ValueError("Выпуск core не является опубликованным стабильным релизом")
    asset = next((row for row in release.get("assets", []) if row.get("name") == asset_name), {})
    digest = asset.get("digest", "")
    url = asset.get("browser_download_url", "")
    if (not isinstance(digest, str) or re.fullmatch(r"sha256:[0-9a-f]{64}", digest) is None
            or not url.startswith("https://github.com/")):
        raise ValueError(f"Отсутствует пакет {asset_name} с SHA-256 GitHub")
    with urllib.request.urlopen(url, timeout=30) as response, archive.open("wb") as output:
        size = 0
        checksum = hashlib.sha256()
        while block := response.read(65536):
            size += len(block)
            if size > MAX_PACKAGE:
                raise ValueError(f"Пакет {asset_name} превышает допустимый размер")
            checksum.update(block)
            output.write(block)
        output.flush()
        os.fsync(output.fileno())
    if checksum.hexdigest() != digest.removeprefix("sha256:"):
        raise ValueError(f"SHA-256 {asset_name} не совпадает с GitHub")


def load_package(archive, tag):
    with zipfile.ZipFile(archive) as bundle:
        infos = bundle.infolist()
        names = [item.filename for item in infos]
        if len(names) != len(set(names)) or len(names) > 256 or sum(i.file_size for i in infos) > MAX_CONTENT:
            raise ValueError("Повторные файлы или превышение лимита core пакета")
        if any(stat.S_ISLNK(i.external_attr >> 16) for i in infos):
            raise ValueError("Symlink в core пакете")
        manifest = json.loads(bundle.read("manifest.json"))
        if (manifest.get("kind") != KIND or manifest.get("schema") != 1
                or manifest.get("tag") != tag or manifest.get("version") != tag[1:]
                or re.fullmatch(r"[0-9a-f]{40}", str(manifest.get("sha"))) is None):
            raise ValueError("Manifest core не соответствует контракту выпуска")
        payload = {}
        for row in manifest["files"]:
            key = row["path"]
            allowed(key)
            if key in payload:
                raise ValueError("Повторное назначение core файла")
            data = bundle.read("payload/" + key)
            if sha(data) != row["sha256"]:
                raise ValueError(f"Повреждён файл пакета: {key}")
            payload[key] = data
        if set(names) != {"manifest.json", *("payload/" + key for key in payload)}:
            raise ValueError("В архиве есть файлы вне manifest")
        required = {"config/printer.cfg", "config/moonraker.conf", "config/moonraker/base/00-core.conf",
                    "klipper/treed_driver_mode.py", "moonraker/treed_update.py", "sbin/treed-core-update"}
        if not required <= payload.keys():
            raise ValueError("Core пакет неполон")
        if "moonraker/treed_vision_client.py" in payload:
            vision_group = {"moonraker/treed_vision_client.py", "camera/stream_detect.py",
                            "vision/service.py", "vision/models.json"}
            if not vision_group <= payload.keys():
                raise ValueError("Core пакет содержит неполный локальный vision runtime")
        validate_autoprinter_files(payload)
        return manifest, payload


def extract_source(archive, directory, manifest, payload):
    provisioning = manifest.get("provisioning")
    if not isinstance(provisioning, dict) or provisioning.get("schema") != 1 or not re.fullmatch(
            r"[0-9a-f]{64}", str(provisioning.get("revision", ""))):
        raise ValueError("В target manifest отсутствует корректная provisioning revision")
    with zipfile.ZipFile(archive) as bundle:
        infos = bundle.infolist()
        names = [row.filename for row in infos]
        if (len(names) != len(set(names)) or len(names) > 4096
                or sum(row.file_size for row in infos) > MAX_CONTENT
                or any(stat.S_ISLNK(row.external_attr >> 16) for row in infos)):
            raise ValueError("Повреждён или небезопасен source package")
        for row in infos:
            name = row.filename
            path = PurePosixPath(name)
            canonical = path.as_posix() + ("/" if row.is_dir() else "")
            if (not name or canonical != name or path.is_absolute() or "\\" in name
                    or ".." in path.parts or name.startswith("/")):
                raise ValueError("Недопустимый путь в source package")
            if row.is_dir():
                continue
            target = directory.joinpath(*path.parts)
            write_file(target, bundle.read(row))
    if not (directory / "loader/loader.sh").is_file():
        raise ValueError("Source package не содержит entrypoint loader")
    if (directory / "VERSION").read_text(encoding="utf-8").strip() != manifest["version"]:
        raise ValueError("VERSION source package не совпадает с runtime manifest")
    source_manifest = package_manifest_for_source(directory, manifest)
    if source_manifest["provisioning"]["revision"] != provisioning["revision"]:
        raise ValueError("Provisioning revision source package не совпадает с target manifest")
    source_files = sources(directory)
    for key, data in payload.items():
        source = source_files.get(key)
        if source is None or source.read_bytes() != data:
            raise ValueError(f"Source package не совпадает с target payload: {key}")
    return directory


def package_manifest_for_source(repo, target_manifest):
    runtime = (repo / "runtime-versions.env").read_text(encoding="utf-8")
    requirements = {}
    for component in ("KLIPPER", "MOONRAKER"):
        match = re.search(rf'^TREED_{component}_REF="([0-9a-f]{{40}})"$', runtime, re.M)
        if not match or match[1] != target_manifest["requires"].get(component.lower()):
            raise ValueError(f"Source package pins {component} не совпадают с target manifest")
        requirements[component.lower()] = match[1]
    return {"provisioning": {"schema": 1, "revision": provisioning_revision(repo)},
            "requires": requirements}


def _managed_upstream_untracked(repo, name, locations, manifests):
    expected = {}
    prefix = name + "/"
    for manifest in manifests:
        if not isinstance(manifest, dict) or not isinstance(manifest.get("files"), list):
            continue
        for row in manifest["files"]:
            if not isinstance(row, dict) or not isinstance(row.get("path"), str):
                continue
            key = row["path"]
            if not key.startswith(prefix):
                continue
            try:
                group, relative = allowed(key)
            except ValueError:
                continue
            digest = row.get("runtimeSha256", row.get("sha256"))
            if group != name or len(relative.parts) != 1 or not re.fullmatch(r"[0-9a-f]{64}", str(digest)):
                continue
            path = locations[name] / relative
            try:
                git_path = path.relative_to(repo).as_posix()
            except ValueError:
                continue
            expected.setdefault(git_path, []).append((key, digest))
    return expected


def _upstream_dirty(repo, name, locations, manifests):
    dirty = subprocess.check_output(["git", "-c", f"safe.directory={repo.resolve().as_posix()}",
                                    "-C", str(repo), "status", "--porcelain", "--untracked-files=all"],
                                    text=True, timeout=10)
    expected = _managed_upstream_untracked(repo, name, locations, manifests)
    for row in dirty.splitlines():
        if not row.startswith("?? "):
            return True
        relative = row[3:]
        for key, digest in expected.get(relative, []):
            path = repo / relative
            if path.is_file() and not path.is_symlink():
                try:
                    if content_hash(key, path.read_bytes()) == digest:
                        break
                except OSError:
                    pass
        else:
            return True
    return False


def check_compatibility(manifest, env, installed=None):
    locations = roots(env)
    managed = (installed,) if installed is not None else ()
    for name, repo in (("klipper", locations["klipper"].parents[1]),
                       ("moonraker", locations["moonraker"].parents[1])):
        if git_head(repo) != manifest["requires"].get(name):
            raise ValueError(f"Пакет требует другую версию {name}; обновление зависимостей выполняется отдельно")
        if _upstream_dirty(repo, name, locations, managed):
            raise ValueError(f"Изменены исходники установленного {name}; core update остановлен")


def check_upstream_clean(locations, installed=None):
    for name, repo in (("klipper", locations["klipper"].parents[1]),
                       ("moonraker", locations["moonraker"].parents[1])):
        if _upstream_dirty(repo, name, locations, (installed,)):
            raise ValueError(f"Изменены исходники установленного {name}; core update остановлен")


def needs_provisioning(target, installed, env):
    requirements = target.get("requires")
    provision = target.get("provisioning")
    if not isinstance(requirements, dict) or any(
            not re.fullmatch(r"[0-9a-f]{40}", str(requirements.get(name, "")))
            for name in ("klipper", "moonraker")):
        raise ValueError("Target manifest не содержит закреплённые upstream SHA")
    if not isinstance(provision, dict) or provision.get("schema") != 1 or not re.fullmatch(
            r"[0-9a-f]{64}", str(provision.get("revision", ""))):
        raise ValueError("Target manifest не содержит корректный provisioning revision")
    if not isinstance(installed, dict) or installed.get("kind") != KIND or installed.get("schema") != 1:
        raise ValueError("Установленный runtime baseline повреждён")
    if not installed.get("provisioning") or installed["provisioning"] != provision:
        return True
    locations = roots(env)
    if not vision_units_installed():
        return True
    for name, repo in (("klipper", locations["klipper"].parents[1]),
                       ("moonraker", locations["moonraker"].parents[1])):
        if git_head(repo) != requirements[name]:
            return True
    return False


def phase(name, message):
    subprocess.run(["/usr/local/sbin/treed-update-service", "phase", name, message], check=True, timeout=10)


def request_json(path, data=None):
    request = "http://127.0.0.1:7125" + path
    if data is not None:
        request = urllib.request.Request(request, data=json.dumps(data).encode("utf-8"),
                                         headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=3) as response:
        return json.load(response)["result"]


def ready(required_components=()):
    try:
        info = request_json("/server/info")
        if not isinstance(info, dict):
            return False
        loaded, failed = info.get("components"), info.get("failed_components")
        if not all(isinstance(items, list) and all(isinstance(item, str) for item in items)
                   for items in (loaded, failed)):
            return False
        required = {"treed_update", "treed_recovery", "treed_detection", "treed_host_network",
                    "treed_filament_sensor", "treed_shell_command", *required_components}
        return (info.get("klippy_state") == "ready" and required <= set(loaded)
                and not required.intersection(failed))
    except (OSError, ValueError, KeyError):
        return False


def idle():
    if not ready():
        return False
    try:
        status = request_json("/printer/objects/query?print_stats=state")["status"]
        state = status["print_stats"]["state"]
        return isinstance(state, str) and state.strip().lower() in {"standby", "complete", "cancelled", "error"}
    except (OSError, ValueError, KeyError):
        return False


def update_admission(action):
    if action not in {"BEGIN", "END"}:
        raise ValueError("Недопустимое действие admission gate")
    request_json("/printer/gcode/script", {"script": f"_TREED_UPDATE_GATE ACTION={action}"})
    state = request_json("/printer/objects/query?gcode_macro%20_TREED_UPDATE_ADMISSION_STATE")
    status = state.get("status") if isinstance(state, dict) else None
    gate = status.get("gcode_macro _TREED_UPDATE_ADMISSION_STATE") if isinstance(status, dict) else None
    expected = 1 if action == "BEGIN" else 0
    if not isinstance(gate, dict) or type(gate.get("active")) is not int or gate["active"] != expected:
        raise RuntimeError(f"Klipper не подтвердил состояние admission gate после {action}")


def services_inactive(units=("klipper.service", "moonraker.service")):
    # Переходное или неизвестное состояние службы не подтверждает остановку.
    for unit in units:
        try:
            result = subprocess.run(["systemctl", "show", "--property=ActiveState", "--value", unit],
                                    check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                    text=True, timeout=10)
        except (OSError, subprocess.SubprocessError, UnicodeError):
            return False
        if not isinstance(result.stdout, str) or result.stdout.strip() not in {"inactive", "failed"}:
            return False
    return True


def services(action):
    vision_units = tuple(unit for unit in ("treed-vision.service", "treed-detection.service")
                         if subprocess.run(["systemctl", "cat", unit], stdout=subprocess.DEVNULL,
                                           stderr=subprocess.DEVNULL, timeout=10).returncode == 0)
    units = (vision_units[::-1] + ("moonraker.service", "klipper.service") if action == "stop"
             else ("klipper.service", "moonraker.service") + vision_units)
    subprocess.run(["systemctl", action, *units], check=True, timeout=60)


def vision_units_installed():
    # Updater доставляет runtime-файлы, но unit и окружение создаёт loader.
    return len(tuple(unit for unit in ("treed-vision.service", "treed-detection.service")
                     if subprocess.run(["systemctl", "cat", unit], stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL, timeout=10).returncode == 0)) == 2


def stop_heating():
    # Обновление само выключает оставшийся нагрев, затем подтверждает результат.
    request_json("/printer/gcode/script", {"script": "TURN_OFF_HEATERS"})
    status = request_json("/printer/objects/query?print_stats=state&extruder=target&heater_bed=target")["status"]
    state = status["print_stats"]["state"]
    if (not isinstance(state, str) or state.strip().lower() not in {"standby", "complete", "cancelled", "error"}
            or status["extruder"]["target"] != 0 or status["heater_bed"]["target"] != 0):
        raise ValueError("Не подтверждена остановка печати и нагрева перед обновлением")


def wait_ready(manifest=None):
    # Старый runtime без AutoPrinter остаётся пригодным для миграции и rollback.
    required = tuple(name for key, name in (
        ("moonraker/treed_autoprinter.py", "treed_autoprinter"),
    ) if manifest and any(row["path"] == key for row in manifest["files"]))
    deadline = time.monotonic() + 60
    consecutive = 0
    while time.monotonic() < deadline:
        consecutive = consecutive + 1 if ready(required) else 0
        if consecutive == 3:
            return True
        time.sleep(1)
    return False


# Блок 4: Durable before-images; до journal никакие runtime-файлы не меняются.
def manifest_path(env):
    return Path(env.get("TREED_CORE_MANIFEST_FILE", "/var/lib/treed-update/core-manifest.json"))


def journal_path(env, operation):
    uuid.UUID(operation)
    return Path(env.get("TREED_CORE_STATE_DIR", "/var/lib/treed-update/core")) / operation / "journal.json"


def process_group_exists(group_id):
    try:
        os.killpg(group_id, 0)
    except ProcessLookupError:
        return False
    return True


def terminate_process_group(process, grace=5):
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + grace
    while time.monotonic() < deadline and process_group_exists(process.pid):
        time.sleep(0.05)
    if process_group_exists(process.pid):
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    process.wait()


def run_managed_loader(source, child_env, log_path, timeout=1500):
    with log_path.open("ab") as log:
        os.chmod(log_path, 0o600)
        try:
            process = subprocess.Popen(["bash", "loader/loader.sh"], cwd=source, env=child_env,
                                       stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        except Exception:
            log.flush()
            os.fsync(log.fileno())
            raise
        try:
            code = process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            terminate_process_group(process)
            code = 124
        log.flush()
        os.fsync(log.fileno())
    return code


def provision_runtime(env, journal, operation):
    child_env = {key: os.environ[key] for key in ("PATH", "HOME", "LANG", "USER", "LOGNAME") if key in os.environ}
    locations = roots(env)
    child_env.update({"PI_USER": env["TREED_UPDATE_PI_USER"], "PI_HOME": env["TREED_UPDATE_PI_HOME"],
                      "TREED_UPDATE_MANAGED": "1", "TREED_UPDATE_MANAGED_LOADER": "1",
                      "TREED_UPDATE_OPERATION_ID": operation, "TREED_DEPLOY_MODE": "preserve",
                      "TREED_SHELL_INSTALL": "0",
                      "TREED_KLIPPER_SRC_DIR": str(locations["klipper"].parents[1]),
                      "TREED_MOONRAKER_SRC_DIR": str(locations["moonraker"].parents[1])})
    return run_managed_loader(journal.parent / "source", child_env, journal.parent / "loader.log")


def verify_runtime_files(manifest, env):
    for row in manifest["files"]:
        data, _info = read_file(destination(row["path"], roots(env)))
        if data is None or not matches_managed_file(row["path"], data, row["runtimeSha256"]):
            raise RuntimeError(f"Runtime файл отличается от проверенного target: {row['path']}")


def baseline(repo, env):
    manifest = package_manifest(repo)
    runtime_sources = sources(repo)
    managed = {"files": [{"path": key, "runtimeSha256": content_hash(key, source.read_bytes())}
                         for key, source in runtime_sources.items()
                         if key.startswith(("klipper/", "moonraker/"))]}
    check_compatibility(manifest, env, managed)
    locations = roots(env)
    for key, source in sorted(runtime_sources.items()):
        data, _info = read_file(destination(key, locations))
        if data is None:
            raise ValueError(f"Baseline: runtime-файл отсутствует: {key}")
        expected = render(key, source.read_bytes(), data, env)
        if content_hash(key, data) != content_hash(key, expected):
            raise ValueError(f"Baseline: файл не соответствует устанавливаемому выпуску: {key}")
        manifest["files"].append({"path": key, "runtimeSha256": content_hash(key, data)})
    write_json(manifest_path(env), manifest)


def config_conflicts(env):
    # Read-only: калибровки SAVE_CONFIG не считаются ручной правкой профиля.
    previous = read_json(manifest_path(env))
    if not previous or previous.get("kind") != KIND or previous.get("schema") != 1:
        raise ValueError("Core baseline отсутствует")
    conflicts = []
    for row in previous["files"]:
        key = row["path"]
        data, _info = read_file(destination(key, roots(env)))
        if data is not None and not matches_managed_file(key, data, row["runtimeSha256"]):
            conflicts.append({"path": key, "sha256": sha(data)})
    return conflicts


def validate_config_resets(value):
    if not isinstance(value, list) or len(value) > 128:
        raise ValueError("Некорректный список сброса конфигов")
    selected = {}
    for row in value:
        if not isinstance(row, dict) or not isinstance(row.get("sha256"), str):
            raise ValueError("Некорректный файл сброса")
        key = row.get("path")
        allowed(key)
        if key in selected or not re.fullmatch(r"[0-9a-f]{64}", row["sha256"]):
            raise ValueError("Некорректный сброс управляемого файла")
        selected[key] = row["sha256"]
    return selected


def prepare(manifest, payload, env, journal, reset_configs=None):
    locations = roots(env)
    previous = read_json(manifest_path(env))
    if not previous or previous.get("kind") != KIND or previous.get("schema") != 1:
        raise ValueError("Core baseline отсутствует; сначала установите новый updater через loader")
    if tuple(map(int, manifest["version"].split("."))) <= tuple(map(int, previous["version"].split("."))):
        raise ValueError("Core пакет не новее установленной версии")
    old_files = {row["path"]: row for row in previous["files"]}
    selected = validate_config_resets([] if reset_configs is None else reset_configs)
    for key in selected:
        if key not in old_files:
            raise ValueError(f"Файл сброса отсутствует в установленном выпуске: {key}")
    entries, installed = [], []
    for index, key in enumerate(sorted(payload.keys() | old_files.keys())):
        path = destination(key, locations)
        old, info = read_file(path)
        if key in selected and (old is None or sha(old) != selected[key]):
            raise ValueError(f"Файл изменился после выбора сброса: {key}; повторите проверку")
        if old is not None and key in old_files and key not in selected and not matches_managed_file(key, old, old_files[key]["runtimeSha256"]):
            raise ValueError(f"Локально изменён управляемый файл: {key}; выберите сброс при обновлении")
        if old is not None and key not in old_files:
            raise ValueError(f"Новое назначение занято неизвестным файлом: {key}")
        backup = str(index)
        if old is not None:
            write_file(journal.parent / backup, old, mode=0o600)
        entry = {"path": key, "backup": backup, "existed": old is not None,
                 "mode": stat.S_IMODE(info.st_mode) if info else 0o644,
                 "uid": info.st_uid if info else 0, "gid": info.st_gid if info else 0}
        data = render(key, payload[key], old, env) if key in payload else None
        if data is not None:
            write_file(journal.parent / (backup + ".new"), data, mode=0o600)
            installed.append({"path": key, "runtimeSha256": content_hash(key, data)})
        entry["delete"] = data is None
        entries.append(entry)
    write_json(journal.parent / "manifest.before.json", previous)
    current = dict(manifest, files=installed)
    write_json(journal.parent / "manifest.new.json", current)
    write_json(journal, {"schema": 1, "stage": "validated", "entries": entries})
    return current


def stop_for_recovery():
    try:
        update_admission("BEGIN")
    except Exception:
        # Moonraker может работать при остановленном Klipper: печать невозможна.
        if not services_inactive(("klipper.service",)):
            raise RuntimeError("Recovery остановлена: admission gate недоступен, а Klipper не подтверждён как остановленный")
    services("stop")
    if not services_inactive():
        raise RuntimeError("Recovery остановлена: systemd не подтвердил остановку Klipper и Moonraker")


def rollback(env, journal, transaction):
    # До начала записи rollback не должен затирать более свежие ручные правки.
    # Старые journal со stage=prepared сохраняют прежний recovery-контракт.
    if transaction["stage"] in {"validated", "aborted"}:
        services("start")
        if not wait_ready(read_json(manifest_path(env))):
            raise RuntimeError("Обновление не началось, но сервисы не прошли readiness")
        try:
            update_admission("END")
        except Exception as release_error:
            raise RuntimeError(f"Recovery не смогла снять admission gate после readiness: {release_error}") from release_error
        transaction["stage"] = "aborted"
        write_json(journal, transaction)
        return {"status": "error", "resultCode": "core_not_installed",
                "message": "Обновление прервано до записи файлов; локальные изменения сохранены. Повторите проверку."}
    try:
        phase("rolling_back", "Восстанавливаем предыдущие компоненты TreeD.")
    except (OSError, subprocess.SubprocessError):
        # Сбой нового service entrypoint не должен мешать возврату его старой копии.
        print("Core rollback: phase notification failed", file=sys.stderr)
    stop_for_recovery()
    locations = roots(env)
    for row in transaction["entries"]:
        path = destination(row["path"], locations)
        if row["existed"]:
            data, _info = read_file(journal.parent / row["backup"])
            if data is None:
                raise ValueError("Резервная копия core неполна")
            write_file(path, data, row["mode"], row["uid"], row["gid"])
        else:
            remove_file(path)
    previous = read_json(journal.parent / "manifest.before.json")
    write_json(manifest_path(env), previous)
    clear_bytecode(transaction["entries"], locations)
    services("start")
    if not wait_ready(previous):
        raise RuntimeError("Файлы восстановлены, но Klipper/Moonraker не прошли readiness")
    transaction["stage"] = "rolled_back"
    write_json(journal, transaction)
    return {"status": "rolled_back", "resultCode": "rollback_succeeded",
            "message": "Предыдущие компоненты TreeD восстановлены и проверены."}


def recover(env, operation):
    journal = journal_path(env, operation)
    transaction = read_json(journal) if journal.parent.exists() else None
    if not transaction:
        return {"status": "error", "resultCode": "operation_interrupted",
                "message": "Обновление core прервано до изменения файлов."}
    if transaction.get("schema") != 1:
        raise ValueError("Неизвестный journal core")
    if transaction.get("provisioningStarted") or transaction.get("stage") in {
            "provisioning", "provisioning_failed", "provisioned"}:
        if transaction.get("stage") == "committed":
            installed = read_json(manifest_path(env))
            expected = read_json(journal.parent / "manifest.new.json")
            if installed == expected and wait_ready(expected):
                return {"status": "applied", "resultCode": "core_updated_recovered",
                        "message": "Готовность установленного TreeD Core после provisioning подтверждена."}
        expected = read_json(journal.parent / "manifest.new.json")
        source = journal.parent / "source"
        if expected and (source / "loader/loader.sh").is_file():
            # Продолжаем тот же проверенный выпуск, не откатывая уже сменённые зависимости.
            with zipfile.ZipFile(journal.parent / SOURCE_ASSET) as bundle:
                for row in bundle.infolist():
                    if not row.is_dir():
                        saved = source / row.filename
                        if saved.is_symlink() or saved.read_bytes() != bundle.read(row):
                            raise ValueError("Recovery source повреждён: " + row.filename)
            if ((source / "VERSION").read_text(encoding="utf-8").strip() != expected["version"]
                    or package_manifest_for_source(source, expected)["provisioning"] != expected["provisioning"]):
                raise ValueError("Recovery source не соответствует сохранённому выпуску")
            verify_runtime_files(expected, env)
            stop_for_recovery()
            transaction.update(stage="provisioning", provisioningStarted=True)
            write_json(journal, transaction)
            if provision_runtime(env, journal, operation):
                transaction["stage"] = "provisioning_failed"
                write_json(journal, transaction)
                return {"status": "error", "resultCode": "provisioning_failed",
                        "message": "Подготовка системы не завершена. Повтор обновления продолжит сохранённую операцию."}
            check_compatibility(expected, env, expected)
            verify_runtime_files(expected, env)
            if not vision_units_installed() or not wait_ready(expected):
                raise RuntimeError("Provisioning recovery не прошла readiness")
            write_json(manifest_path(env), expected)
            transaction["stage"] = "committed"
            write_json(journal, transaction)
            return {"status": "applied", "resultCode": "core_updated_recovered",
                    "message": "Подготовка системы продолжена, новый выпуск установлен и проверен."}
        return {"status": "error", "resultCode": "provisioning_interrupted",
                "message": "Для восстановления не хватает сохранённого source package; файлы и журнал оставлены без изменений."}
    if transaction["stage"] == "committed":
        installed = read_json(manifest_path(env))
        expected = read_json(journal.parent / "manifest.new.json")
        if installed != expected or not wait_ready(expected):
            return rollback(env, journal, transaction)
        return {"status": "applied", "resultCode": "core_updated",
                "message": "Готовность установленного TreeD Core подтверждена."}
    if transaction["stage"] == "rolled_back" and wait_ready(read_json(manifest_path(env))):
        return {"status": "rolled_back", "resultCode": "rollback_succeeded",
                "message": "Готовность восстановленных компонентов TreeD подтверждена."}
    return rollback(env, journal, transaction)


def owner(env):
    import pwd
    import grp
    return (pwd.getpwnam(env["TREED_UPDATE_PI_USER"]).pw_uid,
            grp.getgrnam(env["TREED_UPDATE_PI_GROUP"]).gr_gid)


def apply(tag, operation, env, reset_configs=None):
    if re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+", tag) is None:
        raise ValueError("Недопустимый тег core")
    journal = journal_path(env, operation)
    if journal.exists():
        raise ValueError("Для операции уже существует journal; требуется recovery")
    phase("downloading", "Загружаем и проверяем пакет компонентов TreeD.")
    with tempfile.TemporaryDirectory(prefix="treed-core-") as temp:
        archive = Path(temp) / ASSET
        download(tag, archive, env)
        manifest, payload = load_package(archive, tag)
        previous = read_json(manifest_path(env))
        provision = "provisioning" in manifest
        if provision:
            check_upstream_clean(roots(env), previous)
            provision = needs_provisioning(manifest, previous, env)
            if provision:
                source_archive = journal.parent / SOURCE_ASSET
                with parent_fd(source_archive, create=True):
                    pass
                download(tag, source_archive, env, SOURCE_ASSET)
                extract_source(source_archive, journal.parent / "source", manifest, payload)
            else:
                check_compatibility(manifest, env, previous)
        else:
            check_compatibility(manifest, env, previous)
        uid, gid = owner(env)
        if not provision and not vision_units_installed():
            raise ValueError("Локальный vision runtime ещё не установлен; сначала запустите loader")
        if not idle():
            raise ValueError("Core update требует готового принтера без активной печати или паузы")
        prepare(manifest, payload, env, journal, reset_configs)
    # BEGIN выполняется в последовательной очереди Klipper: проверка состояния
    # и закрытие поддерживаемых входов печати происходят одной командой.
    update_admission("BEGIN")
    try:
        stop_heating()
    except Exception as heater_error:
        try:
            update_admission("END")
        except Exception as release_error:
            print(f"Core update admission release failed: {release_error}", file=sys.stderr)
            raise RuntimeError(f"{heater_error}; admission gate may remain active: {release_error}") from heater_error
        raise
    try:
        phase("installing", "Устанавливаем компоненты TreeD; локальные настройки сохраняются.")
        services("stop")
        if not services_inactive():
            raise RuntimeError("Core update остановлена: systemd не подтвердил остановку Klipper и Moonraker")
        # После остановки Klipper SAVE_CONFIG уже не может изменяться.
        # Переподготовка также подхватывает последнее сохранение до остановки.
        current = prepare(manifest, payload, env, journal, reset_configs)
        transaction = read_json(journal)
        transaction["stage"] = "installing"
        write_json(journal, transaction)
        for row in transaction["entries"]:
            path = destination(row["path"], roots(env))
            if row["delete"]:
                remove_file(path)
            else:
                data, _info = read_file(journal.parent / (row["backup"] + ".new"))
                system = row["path"].startswith("sbin/")
                executable = system or row["path"].startswith("camera/") and row["path"].endswith(".sh")
                write_file(path, data, 0o755 if executable else 0o644, 0 if system else uid, 0 if system else gid)
        clear_bytecode(transaction["entries"], roots(env))
        if provision:
            transaction["stage"] = "provisioning"
            transaction["provisioningStarted"] = True
            write_json(journal, transaction)
            phase("installing", "Обновляем зависимости и службы через loader, сохраняя настройки устройства.")
            result = provision_runtime(env, journal, operation)
            if result:
                transaction["stage"] = "provisioning_failed"
                write_json(journal, transaction)
                release_failed = False
                try:
                    update_admission("END")
                except Exception as release_error:
                    print(f"Core update admission release failed: {release_error}", file=sys.stderr)
                    release_failed = True
                return {"status": "error", "resultCode": "provisioning_failed",
                        "message": "Loader не завершил подготовку системы. Повтор обновления продолжит сохранённую операцию."
                                   + (" Admission gate может оставаться активным; после остановки worker перезапустите Klipper." if release_failed else "")}
            transaction["stage"] = "provisioned"
            write_json(journal, transaction)
            check_compatibility(manifest, env, current)
            if not vision_units_installed():
                raise RuntimeError("Loader завершился без обязательных runtime units")
            verify_runtime_files(current, env)
        phase("restarting", "Запускаем Klipper и Moonraker.")
        if not provision:
            services("start")
        phase("verifying", "Проверяем готовность Klipper и загрузку компонентов Moonraker.")
        if not wait_ready(manifest):
            raise RuntimeError("Новая версия TreeD Core не прошла readiness")
        write_json(manifest_path(env), current)
        transaction["stage"] = "committed"
        write_json(journal, transaction)
        return {"status": "applied", "resultCode": "core_updated", "message": "Обновление TreeD Core завершено."}
    except Exception as error:
        print(f"Core update failed: {error}", file=sys.stderr)
        transaction = read_json(journal)
        if transaction and (transaction.get("provisioningStarted") or transaction.get("stage") in {
                "provisioning", "provisioning_failed", "provisioned"}):
            transaction["stage"] = "provisioning_failed"
            write_json(journal, transaction)
            release_failed = False
            try:
                update_admission("END")
            except Exception as release_error:
                print(f"Core update admission release failed: {release_error}", file=sys.stderr)
                release_failed = True
            return {"status": "error", "resultCode": "provisioning_failed",
                    "message": "Подготовка системы не подтверждена. Повтор обновления продолжит сохранённую операцию."
                               + (" Admission gate может оставаться активным; после остановки worker перезапустите Klipper." if release_failed else "")}
        return rollback(env, journal, transaction)


# Блок 5: CLI build не требует root; device-команды запускаются worker или loader.
def main(argv):
    if len(argv) == 4 and argv[1] == "build":
        build(Path(argv[2]).resolve(), Path(argv[3]).resolve())
        return 0
    if len(argv) == 4 and argv[1] == "build-source":
        build_source(Path(argv[2]).resolve(), Path(argv[3]).resolve())
        return 0
    if len(argv) == 2 and argv[1] == "inspect":
        print(json.dumps({"configConflicts": config_conflicts(settings()), "supportsConfigReset": True}, ensure_ascii=False))
        return 0
    if os.geteuid() != 0:
        raise RuntimeError("Core updater требует root")
    env = settings()
    if len(argv) == 2 and argv[1] == "verify":
        manifest = read_json(manifest_path(env))
        if (not isinstance(manifest, dict) or manifest.get("kind") != KIND
                or manifest.get("schema") != 1 or not manifest.get("files")
                or manifest.get("tag") != f"v{manifest.get('version')}"):
            raise ValueError("Установленный runtime baseline повреждён")
        verify_runtime_files(manifest, env)
        check_compatibility(manifest, env, manifest)
        if not wait_ready(manifest):
            raise RuntimeError("Установленный TreeD Core не прошёл readiness")
        print(json.dumps({"tag": manifest["tag"]}))
        return 0
    if len(argv) == 3 and argv[1] == "baseline":
        import fcntl
        lock_path = Path(env.get("TREED_UPDATE_LOCK_FILE", "/run/lock/treed-update.lock"))
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        with lock_path.open("a+") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            state = read_json(Path(env.get("TREED_UPDATE_STATE_FILE", "/var/lib/treed-update/state.json")))
            if state and state.get("busy"):
                raise ValueError("Baseline запрещён при незавершённом обновлении")
            baseline(Path(argv[2]).resolve(), env)
        return 0
    if len(argv) == 4 and argv[1] == "apply":
        state = read_json(Path(env.get("TREED_UPDATE_STATE_FILE", "/var/lib/treed-update/state.json")))
        if (not state or state.get("busy") is not True or state.get("targetId") != "printer-core"
                or state.get("operationId") != argv[3] or state.get("targetTag") != argv[2]):
            raise ValueError("Core apply требует активную операцию worker")
        result = apply(argv[2], argv[3], env, state.get("resetConfigs", []))
    elif len(argv) == 3 and argv[1] == "recover":
        result = recover(env, argv[2])
    else:
        raise ValueError("usage: treed-core-update build repo zip | build-source repo zip | inspect | verify | baseline repo | apply tag operationId | recover operationId")
    print(json.dumps(result, ensure_ascii=False))
    return 0 if result["status"] == "applied" or argv[1] == "recover" and result["status"] == "rolled_back" else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except Exception as error:
        print(json.dumps({"status": "error", "resultCode": "core_update_failed", "message": str(error)}, ensure_ascii=False))
        raise SystemExit(1)
