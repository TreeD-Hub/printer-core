#!/usr/bin/env bash
set -euo pipefail

# ==========================================
# RUNTIME SCRIPT: TREED UPDATE APPLY
# ==========================================
# Назначение:
# - Атомарно обновляет release bundle `printer-ui` с rollback-копией.
# - Обновляет checkout `printer-core` и запускает штатный loader.
# Контур:
# - root-only, вызывается Moonraker-компонентом через ограниченный sudoers.

# Блок 1: Параметры и state/log файлы.
TARGET_ID="${1:-}"
TARGET_TAG="${2:-}"
ENV_FILE="${TREED_UPDATE_ENV_FILE:-/etc/default/treed-update}"
STATE_FILE="${TREED_UPDATE_STATE_FILE:-/tmp/treed-update-state.json}"
LOG_FILE="${TREED_UPDATE_LOG_FILE:-/tmp/treed-update-apply.log}"
LOCK_FILE="${TREED_UPDATE_LOCK_FILE:-/run/lock/treed-update.lock}"

case "${TARGET_ID}" in
  printer-ui|treed-shell)
    [[ "${TARGET_TAG}" =~ ^ui-main-[0-9]+-[0-9]+$ ]] || {
      echo "treed-update: invalid UI target tag: ${TARGET_TAG}" >&2
      exit 2
    }
    ;;
  printer-core|treed-mainshellos)
    [[ "${TARGET_TAG}" =~ ^v[0-9]+[.][0-9]+[.][0-9]+$ ]] || {
      echo "treed-update: invalid system target tag: ${TARGET_TAG}" >&2
      exit 2
    }
    ;;
  *)
    echo "treed-update: unsupported target: ${TARGET_ID}" >&2
    exit 2
    ;;
esac

if [ -f "${ENV_FILE}" ]; then
  # shellcheck disable=SC1090
  . "${ENV_FILE}"
fi

REPO_DIR="${TREED_UPDATE_REPO_DIR:-/home/pi/treed/printer-core}"
PI_USER="${TREED_UPDATE_PI_USER:-pi}"
PI_GROUP="${TREED_UPDATE_PI_GROUP:-${PI_USER}}"
SHELL_RUNTIME_DIR="${TREED_SHELL_RUNTIME_DIR:-$(dirname "${REPO_DIR}")/treed-shell-runtime}"
SHELL_WEB_DIR="${SHELL_RUNTIME_DIR}/ui"
SHELL_ARCHIVE_PATH="${SHELL_RUNTIME_DIR}/treed-shell-ui.zip"
SHELL_RELEASE_API_URL="${TREED_SHELL_RELEASE_API_URL:-https://api.github.com/repos/TreeD-Hub/printer-ui/releases}"
SHELL_ASSET_NAME="treed-shell-ui.zip"
SHELL_SERVICE="${TREED_SHELL_SERVICE:-treed-shell.service}"
SHELL_HTTP_PORT="${TREED_SHELL_HTTP_PORT:-8787}"
SHELL_START_TIMEOUT="${TREED_SHELL_START_TIMEOUT:-45}"
mkdir -p "$(dirname "${STATE_FILE}")" "$(dirname "${LOG_FILE}")" "$(dirname "${LOCK_FILE}")"
exec >>"${LOG_FILE}" 2>&1

write_state() {
  local status="$1"
  local busy="$2"
  local message="$3"
  local exit_code="${4:-0}"

  python3 - "${STATE_FILE}" "${status}" "${busy}" "${message}" "${TARGET_ID}" "${TARGET_TAG}" "${exit_code}" <<'PY'
import json
import sys
from datetime import datetime, timezone

path, status, busy, message, target_id, target_tag, exit_code = sys.argv[1:8]
payload = {
    "status": status,
    "busy": busy == "1",
    "message": message,
    "targetId": target_id,
    "targetTag": target_tag,
    "exitCode": int(exit_code),
    "updatedAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
}
with open(path, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, ensure_ascii=False, indent=2)
    handle.write("\n")
PY
}

finish() {
  local exit_code="$?"
  if [ "${exit_code}" -eq 0 ]; then
    write_state "applied" "0" "Update applied." "0"
  else
    write_state "error" "0" "Update failed. See ${LOG_FILE}." "${exit_code}"
  fi
  exit "${exit_code}"
}
trap finish EXIT

# Блок 2: Root/lock/repo guards.
if [ "${EUID}" -ne 0 ]; then
  echo "treed-update: run as root" >&2
  exit 1
fi

exec 9>"${LOCK_FILE}"
if ! flock -n 9; then
  echo "treed-update: another update is already running" >&2
  exit 3
fi

apply_core_update() {
  if [ ! -d "${REPO_DIR}/.git" ]; then
    echo "treed-update: repo checkout not found: ${REPO_DIR}" >&2
    return 1
  fi
  if [ ! -f "${REPO_DIR}/install.sh" ]; then
    echo "treed-update: install.sh not found in ${REPO_DIR}" >&2
    return 1
  fi

  cd "${REPO_DIR}"
  git fetch --tags --force origin "refs/tags/${TARGET_TAG}:refs/tags/${TARGET_TAG}"
  git checkout --force "${TARGET_TAG}"
  TREED_DEPLOY_MODE=auto TREED_NONINTERACTIVE=1 bash install.sh
}

resolve_shell_asset_url() {
  python3 - "${SHELL_RELEASE_API_URL}" "${TARGET_TAG}" "${SHELL_ASSET_NAME}" <<'PY'
import json
import sys
import urllib.request

api_url, target_tag, asset_name = sys.argv[1:4]
request = urllib.request.Request(
    api_url,
    headers={"Accept": "application/vnd.github+json", "User-Agent": "treed-update"},
)
with urllib.request.urlopen(request, timeout=30) as response:
    releases = json.load(response)
for release in releases:
    if release.get("draft") or release.get("prerelease") or release.get("tag_name") != target_tag:
        continue
    for asset in release.get("assets") or []:
        if asset.get("name") == asset_name and asset.get("browser_download_url"):
            print(asset["browser_download_url"])
            raise SystemExit(0)
raise SystemExit(f"release asset {asset_name!r} not found for {target_tag!r}")
PY
}

wait_shell_ready() {
  local deadline=$((SECONDS + SHELL_START_TIMEOUT))
  local consecutive_ready=0

  while [ "${SECONDS}" -lt "${deadline}" ]; do
    if systemctl is-active --quiet "${SHELL_SERVICE}" \
      && curl -fsS --max-time 2 "http://127.0.0.1:${SHELL_HTTP_PORT}/index.html" >/dev/null 2>&1; then
      consecutive_ready=$((consecutive_ready + 1))
      if [ "${consecutive_ready}" -ge 3 ]; then
        return 0
      fi
    else
      consecutive_ready=0
    fi
    sleep 1
  done

  return 1
}

apply_shell_update() {
  local archive_url=""
  local tmp_archive=""
  local staged_dir="${SHELL_WEB_DIR}.new"
  local previous_dir="${SHELL_RUNTIME_DIR}/ui.previous"

  if [ "${SHELL_WEB_DIR}" != "${SHELL_RUNTIME_DIR}/ui" ]; then
    echo "treed-update: invalid shell web directory: ${SHELL_WEB_DIR}" >&2
    return 1
  fi

  mkdir -p "${SHELL_RUNTIME_DIR}"
  archive_url="$(resolve_shell_asset_url)"
  tmp_archive="$(mktemp "${SHELL_RUNTIME_DIR}/treed-shell-ui.XXXXXX.zip")"
  curl -fL --connect-timeout 20 --retry 3 --retry-delay 2 -o "${tmp_archive}" "${archive_url}"
  python3 -m zipfile -t "${tmp_archive}" >/dev/null

  rm -rf "${staged_dir}"
  mkdir -p "${staged_dir}"
  python3 -m zipfile -e "${tmp_archive}" "${staged_dir}"
  test -f "${staged_dir}/index.html"
  test -f "${staged_dir}/treed-shell-ui-manifest.json"
  python3 - "${staged_dir}/treed-shell-ui-manifest.json" "${TARGET_TAG}" <<'PY'
import json
import sys

manifest_path, target_tag = sys.argv[1:3]
with open(manifest_path, encoding="utf-8") as handle:
    manifest = json.load(handle)
manifest_tag = f"ui-main-{manifest.get('runNumber')}-{manifest.get('runAttempt')}"
if manifest_tag != target_tag:
    raise SystemExit(f"manifest tag {manifest_tag!r} does not match {target_tag!r}")
if manifest.get("mode") != "live":
    raise SystemExit("UI release manifest mode must be live")
PY

  chown -R "${PI_USER}:${PI_GROUP}" "${staged_dir}"
  rm -rf "${previous_dir}"
  if [ -d "${SHELL_WEB_DIR}" ]; then
    mv "${SHELL_WEB_DIR}" "${previous_dir}"
  fi
  mv "${tmp_archive}" "${SHELL_ARCHIVE_PATH}"
  chown "${PI_USER}:${PI_GROUP}" "${SHELL_ARCHIVE_PATH}"
  if ! mv "${staged_dir}" "${SHELL_WEB_DIR}"; then
    if [ -d "${previous_dir}" ]; then
      mv "${previous_dir}" "${SHELL_WEB_DIR}"
    fi
    return 1
  fi

  if ! systemctl restart "${SHELL_SERVICE}" || ! wait_shell_ready; then
    rm -rf "${SHELL_WEB_DIR}"
    if [ -d "${previous_dir}" ]; then
      mv "${previous_dir}" "${SHELL_WEB_DIR}"
      if systemctl restart "${SHELL_SERVICE}"; then
        wait_shell_ready || true
      fi
    fi
    return 1
  fi
}

# Блок 3: Применение выбранного release target.
write_state "applying" "1" "Applying ${TARGET_ID} ${TARGET_TAG}." "0"
case "${TARGET_ID}" in
  printer-ui|treed-shell) apply_shell_update ;;
  printer-core|treed-mainshellos) apply_core_update ;;
esac
