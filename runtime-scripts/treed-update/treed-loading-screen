#!/usr/bin/env python3
"""Назначение: временный экран ожидания loader на базе темы Plymouth TreeD.
Контур: root-only и bounded; ошибки показа не меняют результат вызывающей операции.
"""

import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time

STATE_DIR = Path("/run/treed-loading-screen")
STATE_FILE = STATE_DIR / "state.json"
LOCK_FILE = STATE_DIR / "lock"
THEME_FILE = Path("/usr/share/plymouth/themes/treed/treed.plymouth")
STATE_OWNER_UID = 0
UI_UNITS = ("treed-shell.service", "KlipperScreen.service")
COMMAND_TIMEOUT = 4
SERVICE_TIMEOUT = 20
START_TIMEOUT = 8
LOCK_TIMEOUT = 3
TTY_PATTERN = re.compile(r"tty[0-9]{1,2}\Z")


# Блок 1: Ограниченный запуск системных команд и закрытая блокировка состояния.
class LoadingScreenError(RuntimeError):
    pass


def log(message):
    print(f"[treed-loading-screen] {message}", file=sys.stderr)


def command(args, timeout=COMMAND_TIMEOUT, check=False):
    try:
        result = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        if check:
            raise LoadingScreenError(f"command failed: {args[0]}") from error
        return False
    if check and result.returncode != 0:
        raise LoadingScreenError(f"command failed: {args[0]} ({result.returncode})")
    return result.returncode == 0


def command_output(args, timeout=COMMAND_TIMEOUT):
    try:
        result = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, timeout=timeout, check=False, text=True)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def ensure_state_dir():
    try:
        STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
        info = STATE_DIR.lstat()
    except OSError as error:
        raise LoadingScreenError("cannot create private state directory") from error
    if not STATE_DIR.is_dir() or STATE_DIR.is_symlink() or info.st_uid != STATE_OWNER_UID:
        raise LoadingScreenError("state directory is not a root-owned directory")
    os.chmod(STATE_DIR, 0o700)


def locked():
    ensure_state_dir()
    flags = os.O_CREAT | os.O_RDWR
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(LOCK_FILE, flags, 0o600)
    os.fchmod(descriptor, 0o600)
    deadline = time.monotonic() + LOCK_TIMEOUT
    while True:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return descriptor
        except BlockingIOError:
            if time.monotonic() >= deadline:
                os.close(descriptor)
                raise LoadingScreenError("another loading-screen operation is active")
            time.sleep(0.05)


def release(descriptor):
    fcntl.flock(descriptor, fcntl.LOCK_UN)
    os.close(descriptor)


# Блок 2: Валидация и атомарное хранение только фиксированного UI/Plymouth-контекста.
def service_state(unit):
    return command_output(["systemctl", "show", "-p", "ActiveState", "--value", unit]) or "unknown"


def active(unit):
    state = service_state(unit)
    if state == "unknown":
        raise LoadingScreenError(f"cannot inspect {unit} state")
    return state == "active"


def ui_may_own_display(unit):
    state = service_state(unit)
    if state == "unknown":
        raise LoadingScreenError(f"cannot inspect {unit} state")
    return state not in {"inactive", "failed", "not-found"}


def wait_state(unit, want_active, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        state = service_state(unit)
        settled = state == "active" if want_active else state in {"inactive", "failed"}
        if settled:
            return True
        time.sleep(0.2)
    state = service_state(unit)
    return state == "active" if want_active else state in {"inactive", "failed"}


def current_vt():
    try:
        value = Path("/sys/class/tty/tty0/active").read_text(encoding="ascii").strip()
    except OSError:
        return ""
    return value if TTY_PATTERN.fullmatch(value) else ""


def load_state():
    try:
        info = STATE_FILE.lstat()
        if not STATE_FILE.is_file() or STATE_FILE.is_symlink() or info.st_uid != STATE_OWNER_UID or info.st_mode & 0o077:
            raise LoadingScreenError("state file is not private and root-owned")
        state = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except (OSError, ValueError, TypeError) as error:
        raise LoadingScreenError("cannot read loading-screen state") from error
    expected = {"schema", "originalVT", "wasTreedShellActive", "wasKlipperScreenActive",
                "daemonOwned", "daemonPid", "daemonModeChanged"}
    if not isinstance(state, dict) or set(state) != expected or state.get("schema") != 1:
        raise LoadingScreenError("invalid loading-screen state")
    if not isinstance(state["originalVT"], str) or state["originalVT"] and not TTY_PATTERN.fullmatch(state["originalVT"]):
        raise LoadingScreenError("invalid VT in loading-screen state")
    for key in ("wasTreedShellActive", "wasKlipperScreenActive", "daemonOwned", "daemonModeChanged"):
        if type(state[key]) is not bool:
            raise LoadingScreenError("invalid boolean in loading-screen state")
    if state["daemonPid"] is not None and (type(state["daemonPid"]) is not int or state["daemonPid"] < 2):
        raise LoadingScreenError("invalid Plymouth PID in state")
    if state["daemonOwned"] != (state["daemonPid"] is not None):
        raise LoadingScreenError("inconsistent Plymouth ownership in state")
    return state


def save_state(state):
    fd, name = tempfile.mkstemp(prefix="state.", suffix=".tmp", dir=STATE_DIR)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(state, stream, sort_keys=True)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, STATE_FILE)
    finally:
        try:
            os.unlink(name)
        except FileNotFoundError:
            pass


def remove_state():
    try:
        STATE_FILE.unlink()
    except FileNotFoundError:
        pass


def private_pid():
    pid_file = STATE_DIR / "plymouthd.pid"
    try:
        info = pid_file.lstat()
        if not pid_file.is_file() or pid_file.is_symlink() or info.st_uid != STATE_OWNER_UID:
            return None
        os.chmod(pid_file, 0o600)
        raw = pid_file.read_text(encoding="ascii").strip()
        return int(raw) if raw.isdigit() and int(raw) > 1 else None
    except (OSError, ValueError):
        return None


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return Path(f"/proc/{pid}/exe").resolve().name == "plymouthd"
    except OSError:
        return False


# Блок 3: Восстановление экрана без команд или путей из state-файла.
def stop_owned_daemon(state):
    if not state["daemonOwned"]:
        if state["daemonModeChanged"] and command(["plymouth", "--ping"]):
            if not command(["plymouth", "change-mode", "--boot"]):
                log("could not restore Plymouth boot mode")
                return False
        return True
    pid = state["daemonPid"]
    if not pid_alive(pid):
        # UI handoff may already have quit our daemon and removed its PID file.
        # Never remove a private PID file that now belongs to another daemon.
        if private_pid() == pid:
            (STATE_DIR / "plymouthd.pid").unlink(missing_ok=True)
        return True
    if private_pid() != pid:
        log("owned Plymouth daemon is no longer the active private daemon; leaving it untouched")
        return False
    if not command(["plymouth", "--ping"]):
        log("owned Plymouth daemon is not responding; leaving it untouched")
        return False
    if not command(["plymouth", "quit"]):
        log("could not stop the owned Plymouth daemon")
        return False
    deadline = time.monotonic() + START_TIMEOUT
    while pid_alive(pid) and time.monotonic() < deadline:
        time.sleep(0.1)
    if pid_alive(pid):
        log("owned Plymouth daemon remained active after quit")
        return False
    try:
        (STATE_DIR / "plymouthd.pid").unlink()
    except FileNotFoundError:
        pass
    return True


def restore_ui(state):
    restored = False
    success = True
    for unit, was_active in zip(UI_UNITS, (state["wasTreedShellActive"], state["wasKlipperScreenActive"])):
        if was_active and not active(unit):
            if not command(["systemctl", "start", "--no-block", unit]):
                log(f"failed to start {unit}")
                success = False
            elif not wait_state(unit, True, SERVICE_TIMEOUT):
                log(f"failed to restore {unit} within {SERVICE_TIMEOUT}s")
                success = False
            else:
                restored = True
        elif was_active:
            restored = True
    if not restored and not any(ui_may_own_display(unit) for unit in UI_UNITS) and state["originalVT"]:
        if not command(["chvt", state["originalVT"][3:]]):
            log(f"failed to restore {state['originalVT']}")
            success = False
    return success


def unwind(state):
    complete = True
    try:
        complete = stop_owned_daemon(state) and complete
    except Exception as error:
        log(f"Plymouth cleanup failed: {error}")
        complete = False
    try:
        complete = restore_ui(state) and complete
    except Exception as error:
        log(f"UI restoration failed: {error}")
        complete = False
    if complete:
        remove_state()
    else:
        log("loading-screen state retained so cleanup can be retried")
    return complete


# Блок 4: Передача VT и запуск уже установленной темы updates.
def ensure_daemon(state):
    if command(["plymouth", "--ping"]):
        if state["daemonOwned"] and (private_pid() != state["daemonPid"] or not pid_alive(state["daemonPid"])):
            state["daemonOwned"] = False
            state["daemonPid"] = None
        state["daemonModeChanged"] = False
        return

    state["daemonOwned"] = False
    state["daemonPid"] = None
    state["daemonModeChanged"] = False
    save_state(state)
    pid_file = STATE_DIR / "plymouthd.pid"
    try:
        pid_file.unlink()
    except FileNotFoundError:
        pass
    command(["plymouthd", "--mode=boot", "--tty=/dev/tty1", f"--pid-file={pid_file}"], check=True)
    deadline = time.monotonic() + START_TIMEOUT
    while private_pid() is None and time.monotonic() < deadline:
        time.sleep(0.1)
    pid = private_pid()
    if pid is None:
        raise LoadingScreenError("Plymouth daemon did not write its private PID")
    state["daemonOwned"] = True
    state["daemonPid"] = pid
    save_state(state)
    deadline = time.monotonic() + START_TIMEOUT
    while not command(["plymouth", "--ping"]) and time.monotonic() < deadline:
        time.sleep(0.1)
    if not command(["plymouth", "--ping"]):
        raise LoadingScreenError("Plymouth daemon did not become available")


def start():
    if os.geteuid() != 0:
        raise LoadingScreenError("start requires root")
    descriptor = locked()
    try:
        if not THEME_FILE.is_file() or not shutil.which("plymouth") or not shutil.which("plymouthd"):
            raise LoadingScreenError("Plymouth theme or command is unavailable")
        state = load_state()
        if state is None:
            ui_service_states = tuple(service_state(unit) for unit in UI_UNITS)
            if "unknown" in ui_service_states:
                raise LoadingScreenError("cannot inspect current UI services")
            ui_states = tuple(state == "active" for state in ui_service_states)
            state = {"schema": 1, "originalVT": current_vt(), "wasTreedShellActive": ui_states[0],
                     "wasKlipperScreenActive": ui_states[1], "daemonOwned": False,
                     "daemonPid": None, "daemonModeChanged": False}
            save_state(state)
        for unit in UI_UNITS:
            if ui_may_own_display(unit):
                command(["systemctl", "stop", "--no-block", unit], check=True)
                if not wait_state(unit, False, SERVICE_TIMEOUT):
                    raise LoadingScreenError(f"{unit} did not stop within {SERVICE_TIMEOUT}s")
        command(["chvt", "1"], check=True)
        ensure_daemon(state)
        command(["plymouth", "change-mode", "--updates"], check=True)
        state["daemonModeChanged"] = True
        save_state(state)
        command(["plymouth", "show-splash"], check=True)
        if not command(["plymouth", "--has-active-vt"]):
            raise LoadingScreenError("Plymouth has no active VT")
        return 0
    except Exception:
        state = load_state()
        if state is not None:
            unwind(state)
        raise
    finally:
        release(descriptor)


# Блок 5: CLI start|stop для внешнего loader/updater lifecycle.
def stop():
    if os.geteuid() != 0:
        raise LoadingScreenError("stop requires root")
    descriptor = locked()
    try:
        state = load_state()
        if state is None:
            return 0
        try:
            daemon_restored = stop_owned_daemon(state)
        except Exception as error:
            log(f"Plymouth cleanup failed: {error}")
            daemon_restored = False
        try:
            ui_restored = restore_ui(state)
        except Exception as error:
            log(f"UI restoration failed: {error}")
            ui_restored = False
        if daemon_restored and ui_restored:
            remove_state()
            return 0
        log("loading-screen state retained so cleanup can be retried")
        return 1
    finally:
        release(descriptor)


def main(argv):
    if len(argv) != 2 or argv[1] not in {"start", "stop"}:
        print("Usage: treed-loading-screen start|stop", file=sys.stderr)
        return 2
    try:
        return start() if argv[1] == "start" else stop()
    except (LoadingScreenError, OSError) as error:
        log(str(error))
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
