# Назначение: root-only короткая проверка срока следующего TreeD Core retry.
# Контур: required; проверка состояния не зависит от Moonraker и printer API.
[Unit]
Description=Check whether a TreeD Core update retry is due

[Service]
Type=oneshot
User=root
Group=root
UMask=0022
Environment=TREED_UPDATE_STATE_FILE=/var/lib/treed-update/state.json
Environment=TREED_UPDATE_LOCK_FILE=/run/lock/treed-update.lock
EnvironmentFile=-/etc/default/treed-update
ExecStart=/usr/local/sbin/treed-update-service retry-due
TimeoutStartSec=10s
StandardOutput=journal
StandardError=journal
