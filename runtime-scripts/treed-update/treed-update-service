STATE = Path(os.environ.get("TREED_UPDATE_STATE_FILE", "/var/lib/treed-update/state.json"))
LOCK = Path(os.environ.get("TREED_UPDATE_LOCK_FILE", "/run/lock/treed-update.lock"))
LOG = Path(os.environ.get("TREED_UPDATE_LOG_FILE", "/var/log/treed-update/worker.log"))
APPLY = os.environ.get("TREED_UPDATE_APPLY", "/usr/local/sbin/treed-update-apply")
UNIT = os.environ.get("TREED_UPDATE_UNIT", "treed-update.service")
CORE_APPLY = os.environ.get("TREED_CORE_UPDATE_COMMAND", "/usr/local/sbin/treed-core-update")
LOADING_SCREEN = Path(__file__).with_name("treed-loading-screen")
TARGET_RE = {
    "printer-ui": re.compile(r"^ui-main-[0-9]+-[0-9]+$"),
    "printer-core": re.compile(r"^v[0-9]+\.[0-9]+\.[0-9]+$"),
}
ACTIVE = {"queued", "validating", "downloading", "installing", "restarting", "verifying", "rolling_back"}
TERMINAL = {"applied", "error", "rolled_back", "rejected"}
PHASES = ACTIVE | TERMINAL | {"idle"}
RETRYABLE_CORE_CODES = {"provisioning_failed", "provisioning_interrupted", "core_update_failed",
                        "core_download_failed", "core_not_ready"}
FRESH_CORE_RETRY_CODES = {"core_download_failed", "core_not_ready"}
RETRY_DELAYS = (30, 120, 300)


def now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def core_journal(state: Dict[str, Any]) -> Path:
    return Path(os.environ.get("TREED_CORE_STATE_DIR", "/var/lib/treed-update/core")) / str(state.get("operationId", "")) / "journal.json"


def packaged_operation(state: Dict[str, Any]) -> bool:
    marker = state.get("packageUpdater")
    return isinstance(marker, dict) and all(marker.get(key) == state.get(key)
                                           for key in ("operationId", "targetId", "targetTag"))


def core_supersede_eligible(state: Dict[str, Any], target_tag: str | None = None) -> bool:
    """Read-only root eligibility check; core updater repeats all transaction checks."""
    if (state.get("targetId") != "printer-core" or state.get("status") != "error"
            or state.get("busy") is True or not isinstance(state.get("targetTag"), str)
            or target_tag is not None and not TARGET_RE["printer-core"].fullmatch(target_tag)):
        return False
    old_match = TARGET_RE["printer-core"].fullmatch(state["targetTag"])
    if not old_match or target_tag is not None and tuple(map(int, target_tag[1:].split("."))) <= tuple(
            map(int, state["targetTag"][1:].split("."))):
        return False
    try:
        uuid.UUID(str(state.get("operationId", "")))
    except (TypeError, ValueError):
        return False
    if packaged_operation(state):
        # Формат старого journal оценивает целевой updater, а не bootstrap.
        return True
    journal = core_journal(state)
    if (journal.is_symlink() or journal.parent.is_symlink() or journal.parent.parent.is_symlink()
            or not journal.is_file()):
        return False
    try:
        transaction = json.loads(journal.read_text(encoding="utf-8"))
        manifest_path = journal.with_name("manifest.new.json")
        if manifest_path.is_symlink() or not manifest_path.is_file():
            return False
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return False
    if (not isinstance(transaction, dict) or not isinstance(transaction.get("schema"), int)
            or isinstance(transaction.get("schema"), bool) or transaction.get("schema") != 1
            or not (transaction.get("provisioningStarted") is True or transaction.get("stage") in {
                "provisioning", "provisioning_failed", "provisioned"})
            or not isinstance(manifest, dict) or not isinstance(manifest.get("schema"), int)
            or isinstance(manifest.get("schema"), bool) or manifest.get("schema") != 1
            or manifest.get("kind") != "treed-core-runtime"
            or manifest.get("version") != state["targetTag"][1:]
            or not isinstance(manifest.get("files"), list) or not manifest["files"]):
        return False
    paths = set()
    for row in manifest["files"]:
        if (not isinstance(row, dict) or not isinstance(row.get("path"), str)
                or row["path"] in paths or not isinstance(row.get("runtimeSha256"), str)
                or not re.fullmatch(r"[0-9a-f]{64}", row["runtimeSha256"])):
            return False
        paths.add(row["path"])
    return True


def add_supersede_status(state: Dict[str, Any]) -> None:
    if core_supersede_eligible(state) or (
            state.get("status") == "error" and corrective_replacement_context(state)):
        state["canSupersedeCore"] = True
    else:
        state.pop("canSupersedeCore", None)


def corrective_replacement_context(state: Dict[str, Any]) -> bool:
    if state.get("supersedesPackagedUpdater") is True:
        return False
    old_id = state.get("supersedesOperationId")
    old_tag = state.get("supersedesTargetTag")
    safe_error = (state.get("status") == "error" and state.get("busy") is not True
                  and state.get("resultCode") in {
                      "core_download_failed", "core_not_ready", "corrective_precondition_deferred",
                      "service_start_failed"}
                  or state.get("status") == "error" and state.get("busy") is not True
                  and state.get("resultCode") == "core_validation_failed"
                  and state.get("lastFailurePhase") in {"queued", "validating", "downloading"})
    safe_queue = (state.get("status") == "queued" and state.get("busy") is True
                  and (state.get("resultCode") in {None, "corrective_precondition_deferred"}
                       or state.get("resultCode") in FRESH_CORE_RETRY_CODES
                       and automatic_fresh_retry_context(state)))
    if (not (safe_error or safe_queue) or state.get("targetId") != "printer-core"
            or not isinstance(old_id, str)
            or not TARGET_RE["printer-core"].fullmatch(old_tag if isinstance(old_tag, str) else "")
            or not TARGET_RE["printer-core"].fullmatch(str(state.get("targetTag", "")))
            or not isinstance(state.get("supersededResetConfigs"), list)):
        return False
    try:
        uuid.UUID(old_id)
        uuid.UUID(str(state.get("operationId", "")))
    except (TypeError, ValueError):
        return False
    old_state = {"operationId": old_id, "targetId": "printer-core", "targetTag": old_tag,
                 "status": "error", "busy": False}
    journal = core_journal(state)
    return (core_supersede_eligible(old_state, state["targetTag"])
            and not journal.is_symlink() and not journal.parent.is_symlink() and not journal.exists())


def klipper_confirmed_inactive() -> bool:
    try:
        result = subprocess.run(["systemctl", "show", "--property=ActiveState", "--value",
                                 "klipper.service"], capture_output=True, text=True,
                                check=False, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return False
    return result.returncode == 0 and result.stdout.strip() in {"inactive", "failed"}


def corrective_admission_safe() -> bool:
    job = printer_job_state()
    return corrective_admission_for_job(job)


def corrective_admission_for_job(job: Optional[str]) -> bool:
    if job in {"printing", "paused"}:
        return False
    if job in {"standby", "complete", "cancelled", "error"}:
        return True
    return klipper_confirmed_inactive()


def defer_corrective_replacement(state: Dict[str, Any]) -> None:
    if not corrective_replacement_context(state):
        return
    scheduled = datetime.now(timezone.utc)
    previous = state.get("retry")
    attempts = previous.get("attempts") if isinstance(previous, dict) else None
    if not isinstance(attempts, int) or isinstance(attempts, bool) or attempts < 1:
        attempts = 1
    state["retry"] = {
        "attempts": attempts,
        "scheduledAt": scheduled.isoformat().replace("+00:00", "Z"),
        "nextAttemptAt": datetime.fromtimestamp(
            scheduled.timestamp() + RETRY_DELAYS[0], timezone.utc).isoformat().replace("+00:00", "Z"),
        "exhausted": False,
        "lastResultCode": "corrective_precondition_deferred",
    }
    state.update(status="error", phase="error", busy=False, progress=None,
                 resultCode="corrective_precondition_deferred",
                 canSupersedeCore=True,
                 message="Замена прерванного обновления отложена до подтверждения безопасного состояния принтера.",
                 updatedAt=state["retry"]["scheduledAt"], finishedAt=state["retry"]["scheduledAt"])
    write_state(state)


def retryable_core_error(state: Dict[str, Any]) -> bool:
    code = state.get("resultCode")
    if state.get("targetId") != "printer-core" or state.get("status") != "error":
        return False
    if code == "corrective_precondition_deferred":
        return corrective_replacement_context(state)
    if code not in RETRYABLE_CORE_CODES:
        return False
    journal = core_journal(state)
    return journal.is_file() or code in FRESH_CORE_RETRY_CODES and not journal.exists() and not journal.is_symlink()


def automatic_fresh_retry_context(state: Dict[str, Any]) -> bool:
    retry = state.get("retry")
    if (state.get("targetId") != "printer-core" or state.get("busy") is not True
            or state.get("resultCode") not in FRESH_CORE_RETRY_CODES or state.get("resumeCore")
            or not isinstance(retry, dict) or retry.get("exhausted") is not False
            or retry.get("nextAttemptAt") is not None or retry.get("lastResultCode") not in FRESH_CORE_RETRY_CODES
            or not isinstance(retry.get("attempts"), int) or isinstance(retry.get("attempts"), bool)
            or not 1 <= retry["attempts"] <= len(RETRY_DELAYS)
            or not isinstance(retry.get("scheduledAt"), str)):
        return False
    generation = state.get("attemptGeneration")
    if not isinstance(generation, int) or isinstance(generation, bool) or generation < 0:
        return False
    try:
        uuid.UUID(str(state.get("operationId", "")))
        scheduled = datetime.fromisoformat(retry["scheduledAt"].replace("Z", "+00:00"))
    except (AttributeError, TypeError, ValueError):
        return False
    if scheduled.tzinfo is None:
        return False
    journal = core_journal(state)
    return not journal.is_symlink() and not journal.parent.is_symlink() and not journal.exists()


def automatic_fresh_retry_pre_mutation(state: Dict[str, Any]) -> bool:
    return (not packaged_operation(state) and state.get("status") in {"queued", "validating", "downloading"}
            and state.get("phase") == state.get("status")
            and automatic_fresh_retry_context(state))


def schedule_retry(state: Dict[str, Any]) -> bool:
    if not retryable_core_error(state):
        return False
    retry = state.get("retry")
    if "retry" not in state:
        attempts = 0
    else:
        retry = state["retry"]
        if (not isinstance(retry, dict) or retry.get("exhausted") is not False
                or not isinstance(retry.get("attempts"), int)
                or isinstance(retry.get("attempts"), bool) or retry["attempts"] < 1):
            return False
        attempts = retry["attempts"]
    if isinstance(retry, dict) and (retry.get("nextAttemptAt") or retry.get("exhausted")):
        return False
    if attempts >= len(RETRY_DELAYS):
        state["retry"] = {"attempts": attempts, "nextAttemptAt": None,
                          "exhausted": True, "lastResultCode": state.get("resultCode")}
        return True
    scheduled_at = datetime.now(timezone.utc)
    due = scheduled_at.timestamp() + RETRY_DELAYS[attempts]
    state["retry"] = {"attempts": attempts + 1,
                      "scheduledAt": scheduled_at.isoformat().replace("+00:00", "Z"),
                      "nextAttemptAt": datetime.fromtimestamp(due, timezone.utc).isoformat().replace("+00:00", "Z"),
                      "exhausted": False, "lastResultCode": state.get("resultCode")}
    return True


def retry_is_due(retry: Any) -> bool:
    if (not isinstance(retry, dict) or retry.get("exhausted") is not False
            or not isinstance(retry.get("attempts"), int) or isinstance(retry.get("attempts"), bool)
            or not 1 <= retry["attempts"] <= len(RETRY_DELAYS)
            or not isinstance(retry.get("scheduledAt"), str)
            or not isinstance(retry.get("nextAttemptAt"), str)):
        return False
    try:
        due = datetime.fromisoformat(retry["nextAttemptAt"].replace("Z", "+00:00"))
        scheduled = datetime.fromisoformat(retry["scheduledAt"].replace("Z", "+00:00"))
    except (TypeError, ValueError):
        return False
    if due.tzinfo is None or scheduled.tzinfo is None:
        return False
    current = datetime.now(timezone.utc)
    # При большом откате часов ограничиваем ожидание максимальной штатной задержкой.
    return (due <= current or (due - current).total_seconds() > max(RETRY_DELAYS)
            or (scheduled - current).total_seconds() > max(RETRY_DELAYS))


def context_matches(state: Dict[str, Any]) -> bool:
    operation_id = os.environ.get("TREED_UPDATE_OPERATION_ID")
    generation = os.environ.get("TREED_UPDATE_ATTEMPT_GENERATION")
    return (operation_id is None and generation is None) or (
        operation_id == str(state.get("operationId", ""))
        and generation == str(state.get("attemptGeneration", 0))
    )


def inherited_lock_fd() -> int | None:
    value = os.environ.get("TREED_UPDATE_LOCK_FD")
    if value is None:
        return None
    if fcntl is None or not value.isdecimal():
        raise RuntimeError("invalid inherited update lock descriptor")
    descriptor = int(value)
    try:
        inherited = os.fstat(descriptor)
        configured = LOCK.stat()
    except OSError as error:
        raise RuntimeError("inherited update lock descriptor is unavailable") from error
    if (not stat.S_ISREG(inherited.st_mode) or inherited.st_dev != configured.st_dev
            or inherited.st_ino != configured.st_ino):
        raise RuntimeError("inherited descriptor does not match the update lock")
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError) as error:
        raise RuntimeError("inherited update lock is not held exclusively") from error
    return descriptor


def read_state() -> Dict[str, Any]:
    if not STATE.exists():
        return {"status": "idle", "phase": "idle", "busy": False, "history": []}
    try:
        value = json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise RuntimeError("persistent update state is unreadable; refusing to replace it") from error
    if not isinstance(value, dict):
        raise RuntimeError("persistent update state has an invalid shape; refusing to replace it")
    return value


def write_state(value: Dict[str, Any]) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temp = STATE.with_name(STATE.name + f".{os.getpid()}.tmp")
    data = (json.dumps(value, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
    descriptor = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    try:
        os.fchmod(descriptor, 0o644)
        with os.fdopen(descriptor, "wb", closefd=False) as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
    finally:
        os.close(descriptor)
    os.replace(temp, STATE)
    if os.name != "nt":
        directory_fd = os.open(STATE.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)


def acquire(blocking: bool = False):
    if fcntl is None:
        raise OSError("TreeD update service requires Linux flock")
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    handle = LOCK.open("a+")
    flags = fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB)
    try:
        fcntl.flock(handle.fileno(), flags)
    except BlockingIOError:
        handle.close()
        return None
    return handle


def response(state: Dict[str, Any], accepted: bool, duplicate: bool = False) -> Dict[str, Any]:
    return {
        "accepted": accepted,
        "duplicate": duplicate,
        "operationId": state.get("operationId"),
        "requestId": state.get("requestId"),
        "status": state.get("status", "busy"),
        "phase": state.get("phase", state.get("status", "busy")),
        "progress": state.get("progress"),
        "resultCode": state.get("resultCode"),
        "message": state.get("message", "Другое обновление уже выполняется."),
        "targetId": state.get("targetId"),
        "targetTag": state.get("targetTag"),
        "retry": state.get("retry"),
        "canSupersedeCore": state.get("canSupersedeCore") is True,
    }


def submit(request_id: str, target_id: str, target_tag: str, ui_target_tag: str | None = None,
           reset_configs_json: str | None = None) -> int:
    if os.geteuid() != 0:
        raise RuntimeError("submit must run as root")
    if not re.fullmatch(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}", request_id):
        raise ValueError("invalid requestId")
    if target_id not in TARGET_RE or not TARGET_RE[target_id].fullmatch(target_tag):
        raise ValueError("invalid update target or release tag")
    ui_target_tag = ui_target_tag or None
    if ui_target_tag is not None and (target_id != "printer-core" or not TARGET_RE["printer-ui"].fullmatch(ui_target_tag)):
        raise ValueError("combined update requires core followed by a valid UI release")
    reset_configs = json.loads(reset_configs_json) if reset_configs_json is not None else []
    # Root boundary: updater повторно проверяет ownership и точный hash файла.
    if not isinstance(reset_configs, list) or len(reset_configs) > 128 or reset_configs and target_id != "printer-core":
        raise ValueError("invalid config reset selection")
    paths = set()
    for row in reset_configs:
        if (not isinstance(row, dict) or not isinstance(row.get("path"), str)
                or not re.fullmatch(
                    r"(?:config/(?:printer\.cfg|moonraker\.conf|"
                    r"profiles/treed_v2_corexy_v1/[a-zA-Z0-9_-]+\.cfg|moonraker/base/[a-zA-Z0-9_-]+\.conf)|"
                    r"(?:klipper|moonraker)/treed_[a-z0-9_]+\.py|"
                    r"camera/(?:cam_env\.sh|session_start\.sh|session_stop\.sh|snapshot\.sh|stream_detect\.py)|"
                    r"vision/(?:service\.py|models\.json)|"
                    r"sbin/(?:treed-core-update|treed-update-service|treed-update-apply|treed-ui|treed-loading-screen))", row["path"])
                or not isinstance(row.get("sha256"), str) or not re.fullmatch(r"[0-9a-f]{64}", row["sha256"])
                or row["path"] in paths):
            raise ValueError("invalid config reset file")
        paths.add(row["path"])
    lock = acquire()
    if lock is None:
        state = read_state()
        duplicate = state.get("requestId") == request_id
        print(json.dumps(response(state, duplicate, duplicate), ensure_ascii=False))
        return 0 if duplicate else 4
    try:
        state = read_state()
        if state.get("requestId") == request_id:
            print(json.dumps(response(state, True, True), ensure_ascii=False))
            return 0
        retry = state.get("retry") if isinstance(state.get("retry"), dict) else {}
        replacement = False
        fresh_after_download_error = False
        old_core_recoverable = core_supersede_eligible(state)
        existing_corrective = corrective_replacement_context(state)
        replacement_anchor: tuple[str, str] | None = None
        packaged_anchor = packaged_operation(state)
        if target_id == "printer-core" and state.get("targetId") == "printer-core" \
                and state.get("status") == "error" and state.get("busy") is not True \
                and target_tag != state.get("targetTag"):
            if core_supersede_eligible(state, target_tag):
                replacement_anchor = (str(state["operationId"]), state["targetTag"])
                if (state.get("supersedesPackagedUpdater") is True and not core_journal(state).exists()
                        and state.get("lastFailurePhase") in {"queued", "validating", "downloading"}):
                    replacement_anchor = (state["supersedesOperationId"], state["supersedesTargetTag"])
            elif (existing_corrective and (
                    state.get("resultCode") in FRESH_CORE_RETRY_CODES | {
                        "service_start_failed", "corrective_precondition_deferred"}
                    or state.get("resultCode") == "core_validation_failed"
                    and state.get("lastFailurePhase") in {"queued", "validating", "downloading"})
                  and not core_journal(state).exists()
                  and tuple(map(int, target_tag[1:].split("."))) > tuple(
                      map(int, state["targetTag"][1:].split(".")))):
                anchor_id = state["supersedesOperationId"]
                anchor_tag = state["supersedesTargetTag"]
                anchor_state = {"operationId": anchor_id, "targetId": "printer-core",
                                "targetTag": anchor_tag, "status": "error", "busy": False}
                if core_supersede_eligible(anchor_state, target_tag):
                    replacement_anchor = (anchor_id, anchor_tag)
            replacement = replacement_anchor is not None
            journal = core_journal(state)
            fresh_after_download_error = (
                state.get("resultCode") == "core_download_failed" and not existing_corrective
                and not journal.exists()
                and not journal.is_symlink() and not journal.parent.is_symlink()
                and TARGET_RE["printer-core"].fullmatch(str(state.get("targetTag", "")))
                and tuple(map(int, target_tag[1:].split("."))) > tuple(
                    map(int, state["targetTag"][1:].split(".")))
            )
            if not replacement and not fresh_after_download_error:
                raise ValueError("Сначала восстановите сохранённый выпуск core")
        if (old_core_recoverable and (target_id != "printer-core" or target_tag != state.get("targetTag"))
                and not replacement):
            raise ValueError("Сначала восстановите сохранённый выпуск core")
        if retry.get("nextAttemptAt") and not retry.get("exhausted") and not replacement and not fresh_after_download_error:
            print(json.dumps(response(state, False), ensure_ascii=False))
            return 4
        if state.get("busy") is True or state.get("status") in ACTIVE:
            print(json.dumps(response(state, False), ensure_ascii=False))
            return 4
        stamp = now()
        operation = {
            "operationId": str(uuid.uuid4()), "requestId": request_id,
            "status": "queued", "phase": "queued", "progress": 0,
            "resultCode": None, "message": "Обновление поставлено в очередь.",
            "targetId": target_id, "targetTag": target_tag,
            "startedAt": stamp, "updatedAt": stamp, "finishedAt": None,
            "busy": True, "history": state.get("history", [])[-9:],
            "attemptGeneration": 0,
        }
        if ui_target_tag is not None:
            operation["pendingUiTag"] = ui_target_tag
        elif target_id == "printer-core" and state.get("pendingUiTag"):
            operation["pendingUiTag"] = state["pendingUiTag"]
        if reset_configs:
            operation["resetConfigs"] = reset_configs
        if (state.get("targetId") == "printer-core" and state.get("status") == "error"
                and (replacement or fresh_after_download_error or state.get("canSupersedeCore") is True
                     or old_core_recoverable or state.get("resumeCore")
                     or state.get("resultCode") in RETRYABLE_CORE_CODES)):
            if replacement:
                operation.update(
                    supersedesOperationId=replacement_anchor[0],
                    supersedesTargetTag=replacement_anchor[1],
                    supersededResetConfigs=(state.get("supersededResetConfigs", [])
                                            if existing_corrective else state.get("resetConfigs", [])),
                )
                if packaged_anchor:
                    reused = replacement_anchor[0] != state["operationId"]
                    operation.update(supersedesPackagedUpdater=True,
                                     supersededPhase=state.get("supersededPhase") if reused else state.get("lastFailurePhase"))
                    if reused:
                        operation["supersededResetConfigs"] = state.get("supersededResetConfigs", [])
            elif fresh_after_download_error:
                pass
            elif target_id != "printer-core" or target_tag != state.get("targetTag"):
                raise ValueError("Сначала повторите прерванное обновление core до сохранённого выпуска")
            elif reset_configs and reset_configs != state.get("resetConfigs", []):
                raise ValueError("При восстановлении нельзя менять согласованный список сброса конфигов")
            if not replacement and not fresh_after_download_error:
                generation = state.get("attemptGeneration", 0)
                if not isinstance(generation, int) or isinstance(generation, bool) or generation < 0:
                    raise ValueError("Некорректное поколение попытки обновления")
                operation.update(operationId=state["operationId"], attemptGeneration=generation + 1,
                                 resumeCore=packaged_operation(state) or core_journal(state).is_file())
                operation.pop("retry", None)
                if state.get("resetConfigs"):
                    operation["resetConfigs"] = state["resetConfigs"]
                if state.get("pendingUiTag") and ui_target_tag is None:
                    operation["pendingUiTag"] = state["pendingUiTag"]
                if existing_corrective:
                    for key in ("supersedesOperationId", "supersedesTargetTag", "supersededResetConfigs"):
                        operation[key] = state[key]
                if packaged_operation(state):
                    operation["packageUpdater"] = state["packageUpdater"]
                    for key in ("supersedesOperationId", "supersedesTargetTag", "supersededResetConfigs",
                                "supersedesPackagedUpdater", "supersededPhase"):
                        if key in state:
                            operation[key] = state[key]
        write_state(operation)
        try:
            subprocess.run(["systemctl", "start", "--no-block", UNIT], check=True, timeout=3)
        except Exception as error:
            operation.update(status="error", phase="error", busy=False,
                             progress=None, resultCode="service_start_failed",
                             message="Не удалось запустить службу обновлений.",
                             updatedAt=now(), finishedAt=now())
            add_supersede_status(operation)
            append_history(operation)
            write_state(operation)
            print(json.dumps(response(operation, False), ensure_ascii=False))
            return 1
        print(json.dumps(response(operation, True), ensure_ascii=False))
        return 0
    finally:
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
        lock.close()


def append_history(state: Dict[str, Any]) -> None:
    history = state.get("history", [])
    if not isinstance(history, list):
        history = []
    summary = {key: state.get(key) for key in (
        "operationId", "requestId", "status", "phase", "progress", "resultCode",
        "message", "targetId", "targetTag", "startedAt", "updatedAt", "finishedAt",
        "resetConfigs", "supersedesOperationId", "supersedesTargetTag", "supersededResetConfigs",
    )}
    history = [item for item in history if isinstance(item, dict)
               and item.get("operationId") != state.get("operationId")]
    state["history"] = (history + [summary])[-10:]


def transition(phase: str, message: str) -> None:
    if phase not in PHASES:
        raise ValueError("unsupported operation phase")
    state = read_state()
    if not context_matches(state):
        return
    if state.get("busy") is not True:
        raise RuntimeError("no active update operation")
    state.update(status=phase, phase=phase, progress=0 if phase == "queued" else None,
                 message=message, updatedAt=now())
    write_state(state)


def printer_job_state() -> Optional[str]:
    request = urllib.request.Request(
        "http://127.0.0.1:7125/printer/objects/query?print_stats=state",
        headers={"Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=3) as response_obj:
            payload = json.load(response_obj)
    except Exception:
        return None
    state = payload.get("result", {}).get("status", {}).get("print_stats", {}).get("state")
    return state.strip().lower() if isinstance(state, str) else None


def printer_is_idle() -> bool:
    state = printer_job_state()
    # Источник допуска — текущее задание, а не остаточные флаги PAUSE/CANCEL.
    return state in {"standby", "complete", "cancelled", "error"}


def finish(state: Dict[str, Any], status: str, result_code: str, message: str) -> None:
    stamp = now()
    failure_phase = state.get("phase", state.get("status"))
    if status == "error" and state.get("targetId") == "printer-core":
        state["lastFailurePhase"] = failure_phase
    state["status"] = status
    if status != "error" or result_code not in {"provisioning_failed", "provisioning_interrupted", "core_update_failed"}:
        state.pop("resumeCore", None)
    state["resultCode"] = result_code
    if status == "error":
        retryable = retryable_core_error(state)
        if retryable:
            schedule_retry(state)
        else:
            state.pop("retry", None)
    else:
        state.pop("retry", None)
    # Блок 3: Второй шаг сохраняется под тем же lock до публикации terminal state.
    # Перезапуск Moonraker/UI не теряет очередь; после ошибки core UI не запускается.
    if status == "applied" and state.get("targetId") == "printer-core" and state.get("pendingUiTag"):
        state.update(targetId="printer-ui", targetTag=state.pop("pendingUiTag"),
                     coreUpdated=True, status="queued", phase="queued", busy=True,
                     progress=0, resultCode=None, updatedAt=stamp, finishedAt=None,
                     message="Система обновлена. Обновляем интерфейс TreeD.")
        write_state(state)
        return
    if state.get("coreUpdated"):
        message = "Система обновлена. " + message
    state.update(status=status, phase="complete" if status in {"applied", "rolled_back"} else status,
                 busy=False, progress=100 if status == "applied" else None,
                 resultCode=result_code, message=message,
                 updatedAt=stamp, finishedAt=stamp)
    add_supersede_status(state)
    append_history(state)
    write_state(state)


def complete_loader() -> int:
    # Блок 3.1: Проверенный standalone loader заменяет прерванный core-переход.
    if os.geteuid() != 0:
        raise RuntimeError("loader completion must run as root")
    borrowed_fd = inherited_lock_fd()
    lock = None if borrowed_fd is not None else acquire()
    if borrowed_fd is None and lock is None:
        raise RuntimeError("Нельзя завершить loader во время активного обновления")
    try:
        state = read_state()
        if state.get("busy") or state.get("status") in ACTIVE:
            raise RuntimeError("Нельзя заменить активную операцию обновления")
        if state.get("targetId") != "printer-core" or state.get("status") != "error" or not (
            state.get("resumeCore") or state.get("resultCode") in {
                "provisioning_failed", "provisioning_interrupted", "core_update_failed"}
        ):
            return 0
        try:
            verified = subprocess.run([CORE_APPLY, "verify"], capture_output=True,
                                      text=True, check=False, timeout=90)
        except subprocess.SubprocessError as error:
            raise RuntimeError("Не удалось проверить установленный loader runtime") from error
        if verified.returncode:
            raise RuntimeError("Установленный loader runtime не прошёл проверку")
        payload = json.loads(verified.stdout)
        tag = payload.get("tag") if isinstance(payload, dict) else None
        previous_tag = state.get("targetTag")
        if not all(isinstance(value, str) and TARGET_RE["printer-core"].fullmatch(value)
                   for value in (tag, previous_tag)):
            raise ValueError("Некорректная версия при завершении loader")
        if tuple(map(int, tag[1:].split("."))) < tuple(map(int, previous_tag[1:].split("."))):
            raise ValueError("Loader установил более раннюю версию, чем незавершённое обновление")
        state["targetTag"] = tag
        finish(state, "applied", "core_updated_via_loader",
               f"Loader завершил установку TreeD Core {tag}; готовность проверена.")
        if state.get("status") == "queued":
            subprocess.run(["systemctl", "start", "--no-block", UNIT], check=True, timeout=3)
        return 0
    finally:
        if lock is not None:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
            lock.close()


def run_core(state: Dict[str, Any], recovery: bool = False) -> int:
    # Блок 3.1: Core сам выбирает runtime/provisioning; A/B adapter не вызывается.
    command = [CORE_APPLY, "recover", state["operationId"]] if recovery else [
        CORE_APPLY, "apply", state["targetTag"], state["operationId"]]
    try:
        execution = package_execution(state, recovery)
        payload = execute_updater(state, execution or (command, {}))
    except PackageDownloadError:
        payload = {"status": "error", "resultCode": "core_download_failed",
                   "message": "Не удалось загрузить пакет updater; повтор сохранит выбранный выпуск."}
    except (OSError, ValueError, KeyError, RuntimeError, zipfile.BadZipFile, subprocess.SubprocessError):
        payload = {"status": "error", "resultCode": "core_update_failed",
                   "message": "Не удалось подтвердить результат core updater; проверьте журнал службы."}
    journal = core_journal(state)
    if payload.get("resultCode") == "core_update_failed" and not journal.exists():
        payload["resultCode"] = "core_validation_failed"
    current = read_state()
    if current.get("operationId") != state.get("operationId") or current.get("attemptGeneration", 0) != state.get("attemptGeneration", 0):
        return 1
    if (payload.get("resultCode") == "core_not_ready" and not journal.exists()
            and not journal.is_symlink() and not journal.parent.is_symlink()):
        current["resultCode"] = "core_not_ready"
        if automatic_fresh_retry_context(current):
            current["retry"]["lastResultCode"] = "core_not_ready"
            defer_fresh_retry(current)
            return 1
    finish(current, payload["status"], str(payload.get("resultCode", "core_update_failed")),
           str(payload.get("message", "Обновление TreeD Core завершено.")))
    return 0 if payload["status"] == "applied" or recovery and payload["status"] == "rolled_back" else 1


# Блок 3.2: Стабильный запускатель; формат установки и journal принадлежат выпуску.
class PackageDownloadError(OSError):
    pass


def executor_directory(state: Dict[str, Any]) -> Path:
    operation = state.get("operationId")
    target, tag = state.get("targetId"), state.get("targetTag")
    if (not isinstance(operation, str) or str(uuid.UUID(operation)) != operation.lower()
            or target not in TARGET_RE or not isinstance(tag, str)
            or TARGET_RE[target].fullmatch(tag) is None):
        raise ValueError("Некорректная привязка updater к операции")
    root = STATE.parent / "executors"
    current = root
    for part in (None, operation, target, tag):
        if part is not None:
            current /= part
        current.mkdir(mode=0o700, exist_ok=True)
        info = current.lstat()
        if (not stat.S_ISDIR(info.st_mode) or current.is_symlink()
                or os.name != "nt" and (info.st_uid != os.geteuid() or info.st_mode & 0o022)):
            raise ValueError("Каталог updater не принадлежит доверенному worker")
    return current


def sync_executor_directory(path: Path) -> None:
    if os.name != "nt":
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)


def write_executor_file(path: Path, data: bytes) -> None:
    # Pin публикуется последним, после durable archive и кода исполнителя.
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as handle:
        temporary = Path(handle.name)
        try:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        except BaseException:
            temporary.unlink(missing_ok=True)
            raise
    try:
        os.replace(temporary, path)
        sync_executor_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def package_execution(state: Dict[str, Any], recovery: bool = False):
    directory = executor_directory(state)
    pin_path, archive, runner = (directory / name for name in ("executor.json", "package.zip", "updater.py"))
    identity = {key: state[key] for key in ("operationId", "targetId", "targetTag")}
    marker = state.get("packageUpdater")
    if pin_path.exists() or pin_path.is_symlink():
        if pin_path.is_symlink() or pin_path.stat().st_size > 8192:
            raise ValueError("Некорректный pin updater")
        pin = json.loads(pin_path.read_text(encoding="utf-8"))
        if (not isinstance(pin, dict) or type(pin.get("protocol")) is not int or pin["protocol"] != 1
                or any(pin.get(key) != value for key, value in identity.items())):
            raise ValueError("Pin updater относится к другой операции")
        for path, key in ((archive, "packageSha256"), (runner, "updaterSha256")):
            expected = pin.get(key)
            if (not isinstance(expected, str) or re.fullmatch(r"[0-9a-f]{64}", expected) is None
                    or path.is_symlink() or not path.is_file()
                    or hashlib.sha256(path.read_bytes()).hexdigest() != expected):
                raise ValueError("Закреплённый updater или его пакет повреждён")
    else:
        if isinstance(marker, dict) and all(marker.get(key) == value for key, value in identity.items()):
            raise ValueError("У начатой операции утрачен закреплённый updater")
        # Старые journal уже были начаты установленным исполнителем.
        if recovery and (state["targetId"] == "printer-core" and core_journal(state).exists()
                         or state.get("phase") not in {"queued", "validating", "downloading"}):
            return None
        target = state["targetId"]
        if target == "printer-core":
            api = os.environ.get("TREED_CORE_RELEASE_API_URL", "https://api.github.com/repos/TreeD-Hub/printer-core/releases")
            asset_name, manifest_name = "treed-core-runtime.zip", "manifest.json"
        else:
            api = os.environ.get("TREED_SHELL_RELEASE_API_URL", "https://api.github.com/repos/TreeD-Hub/printer-ui/releases")
            asset_name, manifest_name = "treed-shell-ui.zip", "treed-shell-ui-manifest.json"
        if re.fullmatch(r"https://api\.github\.com/repos/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases", api) is None:
            raise ValueError("Updater принимает только доверенный GitHub release API")
        transition("downloading", "Загружаем и проверяем updater выбранного выпуска.")
        try:
            request = urllib.request.Request(api + "/tags/" + state["targetTag"],
                                             headers={"Accept": "application/vnd.github+json", "User-Agent": "treed-update-service"})
            with urllib.request.urlopen(request, timeout=15) as response:
                release = json.loads(response.read(1024 * 1024 + 1))
            if (not isinstance(release, dict) or release.get("tag_name") != state["targetTag"]
                    or release.get("draft") or release.get("prerelease")):
                raise ValueError("Updater требует опубликованный стабильный выпуск с точным тегом")
            asset = next((item for item in release.get("assets", [])
                          if isinstance(item, dict) and item.get("name") == asset_name), {})
            digest, url = asset.get("digest"), asset.get("browser_download_url")
            repository = api.removeprefix("https://api.github.com/repos/").removesuffix("/releases")
            prefix = f"https://github.com/{repository}/releases/download/{state['targetTag']}/"
            if (not isinstance(digest, str) or re.fullmatch(r"sha256:[0-9a-f]{64}", digest) is None
                    or not isinstance(url, str) or not url.startswith(prefix)):
                raise ValueError("У release updater отсутствуют доверенный asset и SHA-256")
            data = bytearray()
            with urllib.request.urlopen(url, timeout=30) as response:
                while block := response.read(65536):
                    data.extend(block)
                    if len(data) > 128 * 1024 * 1024:
                        raise ValueError("Пакет updater превышает предел загрузки")
        except (urllib.error.URLError, TimeoutError, ConnectionError, OSError) as error:
            if isinstance(error, urllib.error.HTTPError) and error.code < 500 and error.code != 429:
                raise ValueError("Release updater недоступен") from error
            raise PackageDownloadError(str(error)) from error
        package_hash = hashlib.sha256(data).hexdigest()
        if package_hash != digest.removeprefix("sha256:"):
            raise ValueError("SHA-256 пакета updater не совпадает с GitHub")
        import io
        with zipfile.ZipFile(io.BytesIO(data)) as bundle:
            names = bundle.namelist()
            if len(names) != len(set(names)) or len(names) > 10000:
                raise ValueError("Некорректный список файлов пакета updater")
            manifest_info = bundle.getinfo(manifest_name)
            if manifest_info.file_size > 1024 * 1024:
                raise ValueError("Manifest updater превышает предел размера")
            manifest = json.loads(bundle.read(manifest_info))
            if not isinstance(manifest, dict):
                raise ValueError("Некорректный manifest updater")
            if "updater" not in manifest:
                return None
            meta = manifest["updater"]
            if not isinstance(meta, dict) or type(meta.get("protocol")) is not int or meta["protocol"] != 1:
                raise ValueError("Неизвестный протокол updater пакета")
            entry, expected = meta.get("entrypoint"), meta.get("sha256")
            if (not isinstance(entry, str) or not entry or "\\" in entry
                    or PurePosixPath(entry).is_absolute() or ".." in PurePosixPath(entry).parts
                    or not isinstance(expected, str) or re.fullmatch(r"[0-9a-f]{64}", expected) is None):
                raise ValueError("Некорректный entrypoint updater")
            info = bundle.getinfo(entry)
            if info.is_dir() or stat.S_ISLNK(info.external_attr >> 16) or info.file_size > 8 * 1024 * 1024:
                raise ValueError("Некорректный файл updater")
            code = bundle.read(info)
            if hashlib.sha256(code).hexdigest() != expected:
                raise ValueError("SHA-256 updater не совпадает с manifest")
        pin = dict(identity, protocol=1, packageSha256=package_hash, updaterSha256=expected)
        write_executor_file(archive, bytes(data))
        write_executor_file(runner, code)
        write_executor_file(pin_path, (json.dumps(pin, sort_keys=True) + "\n").encode())
    current = read_state()
    if (any(current.get(key) != value for key, value in identity.items())
            or current.get("attemptGeneration", 0) != state.get("attemptGeneration", 0)):
        raise ValueError("Операция изменилась до запуска updater")
    if current.get("packageUpdater") != identity:
        current["packageUpdater"] = identity
        write_state(current)
    command = [sys.executable, str(runner), "recover", state["operationId"]] if recovery else [
        sys.executable, str(runner), "apply", state["targetTag"], state["operationId"]]
    context = {"TREED_UPDATE_PACKAGE_FILE": str(archive), "TREED_UPDATE_PACKAGE_SHA256": pin["packageSha256"],
               "TREED_UPDATE_PACKAGE_TAG": state["targetTag"]}
    return command, context


def execute_updater(state: Dict[str, Any], execution):
    command, package_environment = execution
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a", encoding="utf-8") as log:
        log.write(f"{now()} {state['targetId']} updater {state['operationId']}\n")
        log.flush()
        context = dict(os.environ, TREED_UPDATE_OPERATION_ID=str(state["operationId"]),
                       TREED_UPDATE_ATTEMPT_GENERATION=str(state.get("attemptGeneration", 0)))
        context.update(package_environment)
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=log, text=True,
                                check=False, env=context)
        log.write(result.stdout + "\n")
    payload = json.loads(result.stdout)
    if (not isinstance(payload, dict) or payload.get("status") not in {"applied", "rolled_back", "error"}
            or payload["status"] == "applied" and result.returncode != 0):
        raise ValueError("invalid updater response")
    return payload


def run_packaged_ui(state: Dict[str, Any], execution, recovery: bool = False) -> int:
    try:
        payload = execute_updater(state, execution)
    except (OSError, ValueError, subprocess.SubprocessError):
        if not recovery and recover_ui(read_state()):
            return 1
        payload = {"status": "error", "resultCode": "update_failed",
                   "message": "Не удалось подтвердить результат updater интерфейса."}
    current = read_state()
    if (current.get("operationId") != state.get("operationId")
            or current.get("attemptGeneration", 0) != state.get("attemptGeneration", 0)):
        return 1
    finish(current, payload["status"], str(payload.get("resultCode", "update_failed")),
           str(payload.get("message", "Обновление интерфейса завершено.")))
    return 0 if payload["status"] in {"applied", "rolled_back"} else 1


def run_worker() -> int:
    if os.geteuid() != 0:
        raise RuntimeError("worker must run as root")
    lock = acquire(blocking=True)
    try:
        while True:
            result = run_current()
            state = read_state()
            if result != 0 or state.get("status") != "queued" or state.get("busy") is not True:
                return result
    finally:
        loading_screen("stop")
        if lock is not None:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
            lock.close()


def run_current() -> int:
    # Блок 4: Один компонент; общий worker удерживает lock между core и UI.
    state = read_state()
    if state.get("status") not in ACTIVE or state.get("busy") is not True:
        return 0
    if state.get("targetId") == "printer-core" and (state.get("status") != "queued" or state.get("resumeCore")):
        return run_core(state, recovery=True)
    try:
        execution = package_execution(state)
    except PackageDownloadError:
        finish(read_state(), "error", "core_download_failed" if state.get("targetId") == "printer-core"
               else "update_failed", "Не удалось загрузить updater выпуска; выбранная версия сохранена.")
        return 1
    except (OSError, ValueError, KeyError, RuntimeError, zipfile.BadZipFile):
        finish(read_state(), "error", "core_validation_failed" if state.get("targetId") == "printer-core"
               else "update_failed", "Не удалось подготовить проверенный updater выпуска.")
        return 1
    if execution is not None:
        if printer_job_state() in {"printing", "paused"}:
            finish(read_state(), "rejected", "printer_not_idle", "Принтер печатает или находится на паузе.")
            return 1
        state = read_state()
        loading_screen("start")
        return run_core(state) if state["targetId"] == "printer-core" else run_packaged_ui(state, execution)
    automatic_fresh_retry = (state.get("status") == "queued"
                             and automatic_fresh_retry_context(state))
    corrective_replacement = (state.get("status") == "queued"
                              and corrective_replacement_context(state))
    if corrective_replacement:
        job_state = printer_job_state()
        idle = job_state in {"standby", "complete", "cancelled", "error"}
    else:
        job_state = None
        idle = printer_is_idle() if automatic_fresh_retry else None
    if automatic_fresh_retry and not corrective_replacement and not idle:
        defer_fresh_retry(state)
        return 0
    if corrective_replacement and not (idle or corrective_admission_for_job(job_state)):
        defer_corrective_replacement(state)
        return 0
    state.update(status="validating", phase="validating", message="Проверяем состояние принтера.", updatedAt=now())
    write_state(state)
    if idle is None:
        idle = printer_is_idle()
    if not idle and not corrective_replacement:
        finish(state, "rejected", "printer_not_idle", "Принтер печатает или его состояние недоступно.")
        return 1
    loading_screen("start")
    if state.get("targetId") == "printer-core":
        return run_core(state)
    transition("downloading", "Загружаем и проверяем UI bundle.")
    state = read_state()
    env = dict(os.environ, TREED_UPDATE_MANAGED="1",
               TREED_UPDATE_OPERATION_ID=str(state.get("operationId", "")),
               TREED_UPDATE_ATTEMPT_GENERATION=str(state.get("attemptGeneration", 0)))
    process = subprocess.run([APPLY, state["targetId"], state["targetTag"]], env=env, check=False)
    state = read_state()
    if process.returncode == 0:
        finish(state, "applied", "ui_updated", "Обновление TreeD UI завершено.")
        return 0
    if not state.get("rollbackSucceeded") and recover_ui(state):
        return process.returncode
    result_code = (
        "rollback_succeeded" if state.get("rollbackSucceeded")
        else "rollback_failed" if state.get("rollbackFailed")
        else "update_failed"
    )
    finish(state, "rolled_back" if state.get("rollbackSucceeded") else "error", result_code,
           "Предыдущая версия TreeD UI восстановлена." if state.get("rollbackSucceeded")
           else "Обновление не выполнено; проверьте журнал службы.")
    return process.returncode


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        raise ValueError("usage: treed-update-service submit|run|phase ...")
    command = argv[1]
    if command == "submit" and len(argv) in (5, 6, 7):
        return submit(*argv[2:])
    if command == "run" and len(argv) == 2:
        return run_worker()
    if command == "recover" and len(argv) == 2:
        return recover()
    if command == "retry-due" and len(argv) == 2:
        return retry_due()
    if command == "complete-loader" and len(argv) == 2:
        return complete_loader()
    if command == "phase" and len(argv) == 4:
        transition(argv[2], argv[3])
        return 0
    raise ValueError("invalid command arguments")


def recover() -> int:
    if os.geteuid() != 0:
        raise RuntimeError("recovery must run as root")
    lock = acquire(blocking=True)
    try:
        state = read_state()
        if automatic_fresh_retry_pre_mutation(state):
            defer_fresh_retry(state)
            return 0
        if state.get("targetId") == "printer-core" and state.get("status") != "queued" and (
            state.get("busy") is True or state.get("status") in ACTIVE
        ):
            result = run_core(state, recovery=True)
            state = read_state()
            if state.get("status") != "queued":
                return result
        # При boot PathChanged не обязан заметить уже существующий queued-файл.
        if state.get("status") == "queued":
            subprocess.run(["systemctl", "start", "--no-block", UNIT], check=True, timeout=3)
            return 0
        if state.get("busy") is True or state.get("status") in ACTIVE:
            if state.get("targetId") == "printer-ui" and recover_ui(state):
                return 0
            finish(state, "error", "operation_interrupted",
                   "Обновление прервано до записи результата; проверьте текущую версию перед повтором.")
        else:
            state = read_state()
            if state.get("status") == "error" and retryable_core_error(state):
                retry = state.get("retry")
                if "retry" not in state:
                    if schedule_retry(state):
                        write_state(state)
                elif retry_is_due(retry):
                    queue_retry(state)
        return 0
    finally:
        loading_screen("stop")
        if lock is not None:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
            lock.close()


def queue_retry(state: Dict[str, Any]) -> None:
    retry = state.get("retry")
    generation = state.get("attemptGeneration", 0)
    if (not retry_is_due(retry) or not retryable_core_error(state)
            or not isinstance(generation, int) or isinstance(generation, bool) or generation < 0):
        return
    if printer_job_state() in {"printing", "paused"}:
        return
    state.update(status="queued", phase="queued", busy=True, progress=0,
                 attemptGeneration=generation + 1,
                 message="Повтор TreeD Core поставлен в очередь.", updatedAt=now(), finishedAt=None)
    state.pop("canSupersedeCore", None)
    state["retry"].update(nextAttemptAt=None, lastResultCode=state.get("resultCode"))
    state["resumeCore"] = (
        False if state.get("resultCode") == "corrective_precondition_deferred"
        else state.get("resultCode") not in FRESH_CORE_RETRY_CODES or core_journal(state).is_file()
    )
    write_state(state)
    subprocess.run(["systemctl", "start", "--no-block", UNIT], check=True, timeout=3)


def defer_fresh_retry(state: Dict[str, Any]) -> None:
    retry = state.get("retry")
    if not automatic_fresh_retry_context(state):
        return
    stamp = datetime.now(timezone.utc)
    retry["scheduledAt"] = stamp.isoformat().replace("+00:00", "Z")
    retry["nextAttemptAt"] = datetime.fromtimestamp(
        stamp.timestamp() + RETRY_DELAYS[0], timezone.utc).isoformat().replace("+00:00", "Z")
    retry["lastResultCode"] = state.get("resultCode")
    state.update(status="error", phase="error", busy=False, progress=None,
                 message="Автоматический повтор TreeD отложен до подтверждения состояния принтера.",
                 updatedAt=retry["scheduledAt"], finishedAt=retry["scheduledAt"])
    write_state(state)


def retry_due() -> int:
    if os.geteuid() != 0:
        raise RuntimeError("retry scheduler must run as root")
    lock = acquire()
    if lock is None:
        return 0
    try:
        state = read_state()
        previous_marker = state.get("canSupersedeCore")
        add_supersede_status(state)
        if state.get("canSupersedeCore") != previous_marker:
            write_state(state)
        if state.get("status") != "error" or not retry_is_due(state.get("retry")):
            return 0
        queue_retry(state)
        return 0
    finally:
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
        lock.close()


def loading_screen(action: str) -> None:
    """Запускает необязательный splash без влияния на результат обновления."""
    try:
        result = subprocess.run([sys.executable, str(LOADING_SCREEN), action], check=False,
                                timeout=90, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if result.returncode:
            print(f"Не удалось выполнить loading screen ({action}).", file=sys.stderr)
    except (OSError, subprocess.SubprocessError):
        print(f"Не удалось выполнить loading screen ({action}).", file=sys.stderr)


def shell_runtime_dir() -> Path:
    configured = os.environ.get("TREED_SHELL_RUNTIME_DIR")
    if not configured:
        env_file = Path(os.environ.get("TREED_UPDATE_ENV_FILE", "/etc/default/treed-update"))
        try:
            lines = env_file.read_text(encoding="utf-8").splitlines()
        except OSError:
            lines = []
        for line in lines:
            match = re.fullmatch(r'TREED_SHELL_RUNTIME_DIR="([^"\r\n]+)"', line.strip())
            if match:
                configured = match.group(1)
                break
    if not configured:
        pi_home = os.environ.get("TREED_UPDATE_PI_HOME", "/home/pi")
        configured = str(Path(pi_home) / "treed" / "treed-shell-runtime")
    runtime = Path(configured)
    parts = runtime.parts
    if (not runtime.is_absolute() or ".." in parts or len(parts) != 5
            or parts[0] != "/" or parts[1] != "home"
            or parts[3:] != ("treed", "treed-shell-runtime")):
        raise ValueError("invalid TreeD Shell runtime path")
    return runtime


def wait_shell_ready(runtime: Path) -> bool:
    service_name = os.environ.get("TREED_SHELL_SERVICE", "treed-shell.service")
    port = os.environ.get("TREED_SHELL_HTTP_PORT", "8787")
    deadline = time.monotonic() + 45
    consecutive = 0
    while time.monotonic() < deadline:
        active = subprocess.run(["systemctl", "is-active", "--quiet", service_name],
                                check=False, timeout=3).returncode == 0
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}/index.html", timeout=2):
                ready = active
        except Exception:
            ready = False
        consecutive = consecutive + 1 if ready else 0
        if consecutive >= 3:
            return True
        time.sleep(1)
    return False


def recover_ui(state: Dict[str, Any]) -> bool:
    try:
        execution = package_execution(state, recovery=True)
    except (OSError, ValueError, KeyError, RuntimeError, zipfile.BadZipFile):
        finish(state, "error", "rollback_failed", "Закреплённый updater UI недоступен для восстановления.")
        return True
    if execution is not None:
        run_packaged_ui(state, execution, recovery=True)
        return True
    operation_id = state.get("operationId")
    if not isinstance(operation_id, str) or not re.fullmatch(r"[0-9a-fA-F-]{36}", operation_id):
        return False
    try:
        runtime = shell_runtime_dir()
    except ValueError:
        finish(state, "error", "invalid_runtime_path", "Не удалось безопасно определить каталог TreeD UI.")
        return True
    rollback = runtime / f"ui.rollback.{operation_id}"
    current = runtime / "ui"
    if not rollback.is_dir() or rollback.is_symlink():
        if current.is_dir() and not current.is_symlink() and ui_manifest_matches(
            current / "treed-shell-ui-manifest.json", state.get("targetTag")
        ) and wait_shell_ready(runtime):
            finish(state, "applied", "ui_updated_recovered",
                   "После прерывания подтверждена готовность новой версии TreeD UI.")
            return True
        return False
    if current.is_symlink():
        finish(state, "error", "rollback_failed", "Нельзя безопасно восстановить TreeD UI: текущий каталог является ссылкой.")
        return True
    try:
        if current.exists():
            shutil.rmtree(current)
        # Копия остаётся пригодной для повтора при отключении питания во время отката.
        shutil.copytree(rollback, current, symlinks=True)
    except OSError:
        finish(state, "error", "rollback_failed", "Не удалось вернуть файлы предыдущей версии TreeD UI.")
        return True
    service_name = os.environ.get("TREED_SHELL_SERVICE", "treed-shell.service")
    try:
        subprocess.run(["sync", "-f", str(runtime)], check=True, timeout=30)
        subprocess.run(["systemctl", "restart", service_name], check=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        finish(state, "error", "rollback_failed", "Не удалось завершить возврат файлов или перезапустить TreeD UI.")
        return True
    if not wait_shell_ready(runtime):
        finish(state, "error", "rollback_failed", "Предыдущие файлы возвращены, но проверка TreeD UI не прошла.")
        return True
    finish(state, "rolled_back", "rollback_succeeded", "После прерывания восстановлена предыдущая версия TreeD UI.")
    return True


def ui_manifest_matches(path: Path, expected_tag: Any) -> bool:
    if not isinstance(expected_tag, str):
        return False
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    actual_tag = f"ui-main-{manifest.get('runNumber')}-{manifest.get('runAttempt')}"
    return actual_tag == expected_tag and manifest.get("mode") == "live"


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except (OSError, RuntimeError, ValueError) as error:
        print(json.dumps({"accepted": False, "status": "error", "phase": "error",
                          "message": str(error)}, ensure_ascii=False))
        raise SystemExit(1)
