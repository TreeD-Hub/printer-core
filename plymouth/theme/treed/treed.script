# ==========================================
# PLYMOUTH SCRIPT: TREED
# ==========================================
# Назначение: ранняя загрузка в оформлении экрана обновления TreeD UI.
# Контур: boot splash; не оценивает готовность Klipper и не меняет службы.

# Блок 1: Чёрный фон и геометрия целевого экрана.
Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen.x = Window.GetX();
screen.y = Window.GetY();
screen.width = Window.GetWidth();
screen.height = Window.GetHeight();
screen.scale = screen.width / 960;
if (screen.height / 544 < screen.scale) screen.scale = screen.height / 544;
screen.content_x = screen.x + (screen.width - 960 * screen.scale) / 2;
screen.content_y = screen.y + (screen.height - 544 * screen.scale) / 2;

# Блок 2: Тот же логотип 500x144, что и в UpdateOperationScreen.
logo.image = Image("watermark.png").Scale(500 * screen.scale, 144 * screen.scale);
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(screen.x + (screen.width - logo.image.GetWidth()) / 2,
                        screen.content_y + 119 * screen.scale, 10);

# Блок 3: Подписи запуска без выдуманных этапов и процентов готовности.
header_text = "Запуск системы";
title_text = "Запуск TreeD";
detail_text = "Подготавливаем систему и интерфейс принтера.";
if (Plymouth.GetMode() == "shutdown") {
    header_text = "Выключение системы";
    title_text = "Завершение работы";
    detail_text = "Ожидаем остановки служб принтера.";
}
if (Plymouth.GetMode() == "updates") {
    header_text = "Обновление системы";
    title_text = "Применяем обновление";
    detail_text = "Пожалуйста, подождите.";
}

header.image = Image.Text(header_text, 0.75, 0.75, 0.75, 1, "monospace 18px");
header.image = header.image.Scale(header.image.GetWidth() * screen.scale, header.image.GetHeight() * screen.scale);
header.sprite = Sprite(header.image);
header.sprite.SetPosition(screen.content_x + 32 * screen.scale, screen.content_y + 24 * screen.scale, 10);

title.image = Image.Text(title_text, 0.8, 0.8, 0.8, 1, "monospace 32px");
title.image = title.image.Scale(title.image.GetWidth() * screen.scale, title.image.GetHeight() * screen.scale);
title.sprite = Sprite(title.image);
title.sprite.SetPosition(screen.x + (screen.width - title.image.GetWidth()) / 2,
                         screen.content_y + 333 * screen.scale, 10);

detail.image = Image.Text(detail_text, 0.75, 0.75, 0.75, 1, "monospace 18px");
detail.image = detail.image.Scale(detail.image.GetWidth() * screen.scale, detail.image.GetHeight() * screen.scale);
detail.sprite = Sprite(detail.image);
detail.sprite.SetPosition(screen.x + (screen.width - detail.image.GetWidth()) / 2,
                          screen.content_y + 385 * screen.scale, 10);

# Блок 4: Нижняя полоса ожидания — тот же размер и движение, что у UI.
bar.height = 16 * screen.scale;
bar.width = screen.width;
bar.segment_width = Math.Int(bar.width * 0.24);
bar.y = screen.y + screen.height - bar.height;
bar.track = Sprite(Image("prog.png").Scale(bar.width, bar.height));
bar.track.SetPosition(screen.x, bar.y, 20);
bar.track.SetOpacity(0.14);
bar.segment = Sprite(Image("prog.png").Scale(bar.segment_width, bar.height));
bar.segment.SetOpacity(0.8);
bar.frame = 0;

# Блок 5: Plymouth вызывает refresh; таймеров SetTimer в его API нет.
fun refresh_callback ()
{
    eased = (1 - Math.Cos(3.141592653589793 * bar.frame / 59)) / 2;
    bar.segment.SetPosition(screen.x - bar.segment_width + (bar.width + bar.segment_width) * eased, bar.y, 21);
    bar.frame = (bar.frame + 1) % 60;
}

refresh_callback();
Plymouth.SetRefreshFunction(refresh_callback);
# При quit Plymouth сохраняет последний кадр для перехода в kiosk без fade в пустой экран.
